#!/home/claude/venvs/transcribe/bin/python3
"""Analyze Claude Code's admitted mistakes and explicit apologies."""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import date, datetime, timedelta
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from cww_core import (  # noqa: E402
    COMPILED_PATTERNS,
    ET,
    IndexLock,
    load_report,
    open_index,
    refresh_index,
)
from cww_render import (  # noqa: E402
    audit_rows,
    legacy_json,
    render_audit,
    render_html,
    render_tui,
)


DEFAULT_DAYS = 30


def positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be an integer") from exc
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return parsed


def context_override(value: str) -> tuple[str, int]:
    if "=" not in value:
        raise argparse.ArgumentTypeError("must be MODEL=TOKENS")
    model, raw_tokens = value.rsplit("=", 1)
    try:
        tokens = int(raw_tokens.replace("_", "").replace(",", ""))
    except ValueError as exc:
        raise argparse.ArgumentTypeError("TOKENS must be an integer") from exc
    if not model or tokens < 1:
        raise argparse.ArgumentTypeError("must be MODEL=TOKENS with TOKENS > 0")
    return model, tokens


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="claude-was-wrong",
        description=(
            "Analyze admitted mistakes, explicit apologies, and probable correction "
            "language in local Claude Code transcripts."
        ),
        epilog=(
            "Examples:\n"
            "  claude-was-wrong\n"
            "  claude-was-wrong --days 7\n"
            "  claude-was-wrong --html error-weather.html\n"
            "  claude-was-wrong --audit probable --include-snippets\n"
            "  claude-was-wrong --population main --model opus --json"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    window = parser.add_mutually_exclusive_group()
    window.add_argument(
        "--days",
        "--day",
        type=positive_int,
        default=DEFAULT_DAYS,
        metavar="N",
        help=f"last N Eastern Time calendar days (default: {DEFAULT_DAYS})",
    )
    window.add_argument("--since", metavar="YYYY-MM-DD", help="start date in Eastern Time")
    window.add_argument("--all", action="store_true", help="entire indexed archive")

    output = parser.add_mutually_exclusive_group()
    output.add_argument("--json", action="store_true", help="machine-readable JSON")
    output.add_argument("--html", type=Path, metavar="FILE", help="write self-contained HTML report")
    output.add_argument(
        "--audit",
        nargs="?",
        const="probable",
        choices=("exact", "probable", "all"),
        help="list auditable matches (default tier: probable)",
    )

    parser.add_argument(
        "--population",
        choices=("all", "main", "subagents"),
        default="all",
        help="population filter; all keeps main/sub-agent series separate",
    )
    parser.add_argument("--model", help="model id substring filter")
    parser.add_argument("--project", help="project label substring filter")
    parser.add_argument(
        "--include-snippets",
        action="store_true",
        help="include locally redacted matched clauses in HTML/audit output",
    )
    parser.add_argument("--limit", type=positive_int, default=100, help="audit row limit")
    parser.add_argument("--rebuild-index", action="store_true", help="discard and rebuild index")
    parser.add_argument(
        "--transcripts-dir",
        type=Path,
        default=Path(os.environ.get("CLAUDE_TRANSCRIPTS_DIR", "~/.claude/projects")).expanduser(),
        metavar="PATH",
    )
    parser.add_argument(
        "--state-dir",
        type=Path,
        default=Path(os.environ.get("CLAUDE_WAS_WRONG_STATE_DIR", "~/.world/claude-was-wrong")).expanduser(),
        metavar="PATH",
    )
    parser.add_argument(
        "--context-window",
        action="append",
        type=context_override,
        default=[],
        metavar="MODEL=TOKENS",
        help="override estimated context window; repeatable",
    )
    parser.add_argument("--no-color", action="store_true", help="disable ANSI styling")
    return parser.parse_args()


def parse_since(args: argparse.Namespace) -> tuple[date | None, date]:
    today = datetime.now(ET).date()
    if args.all:
        return None, today
    if args.since:
        try:
            return date.fromisoformat(args.since), today
        except ValueError as exc:
            raise ValueError("--since must be a valid date in YYYY-MM-DD format") from exc
    return today - timedelta(days=args.days - 1), today


def main() -> int:
    args = parse_args()
    if args.include_snippets and not (args.html or args.audit):
        print(
            "claude-was-wrong: --include-snippets requires --html or --audit",
            file=sys.stderr,
        )
        return 2
    if not args.transcripts_dir.is_dir():
        print(
            f"claude-was-wrong: transcript directory not found: {args.transcripts_dir}",
            file=sys.stderr,
        )
        return 2
    try:
        since, until = parse_since(args)
    except ValueError as exc:
        print(f"claude-was-wrong: {exc}", file=sys.stderr)
        return 2

    state_dir = args.state_dir.expanduser()
    index_path = state_dir / "index.sqlite3"
    overrides = dict(args.context_window)
    try:
        with IndexLock(state_dir / "index.lock"):
            conn = open_index(index_path)
            try:
                refresh_index(
                    conn,
                    args.transcripts_dir.expanduser(),
                    rebuild=args.rebuild_index,
                    overrides={},
                    progress=True,
                )
                report = load_report(
                    conn,
                    since=since,
                    until=until,
                    population="subagent" if args.population == "subagents" else args.population,
                    model_filter=args.model,
                    project_filter=args.project,
                    include_rows=bool(args.html or args.audit),
                    context_overrides=overrides,
                )
            finally:
                conn.close()
    except (OSError, json.JSONDecodeError) as exc:
        print(f"claude-was-wrong: index error: {exc}", file=sys.stderr)
        return 1

    phrases = [pattern.phrase for pattern, _ in COMPILED_PATTERNS]
    if args.json:
        print(json.dumps(legacy_json(report, phrases), indent=2, ensure_ascii=False))
    elif args.audit:
        selected = audit_rows(report, args.audit, args.include_snippets, args.limit)
        print(render_audit(selected, args.include_snippets))
    elif args.html:
        target = args.html.expanduser().resolve()
        render_html(report, target, include_snippets=args.include_snippets)
        print(f"Wrote {target}")
    else:
        color = not args.no_color and "NO_COLOR" not in os.environ and sys.stdout.isatty()
        print(render_tui(report, color=color))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
