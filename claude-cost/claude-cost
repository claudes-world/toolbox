#!/usr/bin/env python3
"""Estimate Claude Code API-equivalent cost from local session logs.

Parses ~/.claude/projects/**/*.jsonl (the transcripts Claude Code writes for
every session and subagent), sums token usage per model, and applies
cache-aware Anthropic list pricing. Useful for: "what did the last N days of
work cost?", feeding a cost tile in the CPC mini-app (--json), or an agent
checking spend before a big run.

Pricing uses current official rates (checked 2026-09-12); the
Max subscription bills by quota, so treat the number as "what this would cost
on the metered API", not a literal invoice.

Usage:
    claude-cost                     # last 3 days, human table
    claude-cost --days 7            # last 7 days
    claude-cost --since 2026-07-01  # explicit start (UTC)
    claude-cost --by-project        # break down per project dir
    claude-cost --model fable       # only models matching substring
    claude-cost --json              # machine-readable (for CPC / agents)

Cache-aware pricing: reads bill at 0.025x for Fable/Mythos 5.1, otherwise
0.1x input; 5-minute cache writes at
1.25x, 1-hour cache writes at 2x. The "naive" figure is what the same work
would cost with no prompt caching at all.
"""

import argparse
import glob
import json
import os
import sys
import time
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from cost_progress import Progress
from cost_accounting import (CLAUDE, model_key, rates_for, integer, accounting_blank,
                             add_issue, account, merge_accounting, accounting_json,
                             pricing_metadata, print_accounting)

# Input/read/5m-write/1h-write/output prices are independently specified per model.
PRICING = CLAUDE


def price_for(model):
    key = model_key(model, "claude")
    return key, PRICING.get(key)


def blank():
    return dict(calls=0, fresh_in=0, cache_read=0, cw5m=0, cw1h=0, cw_unknown=0,
                out=0, cost=0.0, cost_intro=0.0, naive=0.0, **accounting_blank())


def in_window(timestamp, cutoff):
    """Return False when a bounded-window record has no valid UTC timestamp."""
    if cutoff is None:
        return True
    if not timestamp:
        return False
    try:
        parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            return False
        return parsed.astimezone(timezone.utc) >= cutoff
    except (TypeError, ValueError):
        return False


def parse(projects_dir, cutoff, model_filter, *, progress=None):
    progress = progress if progress is not None else Progress(enabled=False)
    by_model = defaultdict(blank)
    by_project = defaultdict(blank)
    selected = {}
    files = []
    total_bytes = 0
    for fp in glob.iglob(os.path.join(projects_dir, "**", "*.jsonl"), recursive=True):
        files.append(fp)
        progress.advance(found=1)
        try:
            total_bytes += os.stat(fp).st_size
        except OSError:
            pass  # The read below reports the error and marks incomplete usage.
    progress.update(stage="Parsing", total_files=len(files), total_bytes=total_bytes,
                    parse_started=time.monotonic())
    # Choose one final record across transcript copies before applying the window.
    for fp in sorted(files):
        project = os.path.relpath(fp, projects_dir).split(os.sep, 1)[0]
        pending_bytes = 0
        try:
            with open(fp, "rb") as handle:
                for ordinal, line in enumerate(handle):
                    pending_bytes += len(line)
                    if pending_bytes >= 4 * 1024 * 1024:
                        progress.advance(done_bytes=pending_bytes)
                        pending_bytes = 0
                    if b'"usage"' not in line:
                        continue
                    try:
                        obj = json.loads(line.decode("utf-8", errors="replace"))
                    except (TypeError, ValueError):
                        continue
                    if not isinstance(obj, dict):
                        continue
                    msg = obj.get("message") or {}
                    if not isinstance(msg, dict):
                        continue
                    usage = msg.get("usage") or obj.get("usage")
                    model = msg.get("model") or obj.get("model")
                    if not isinstance(usage, dict) or not usage or not isinstance(model, str):
                        continue
                    model = model.lower()
                    if model in ("<synthetic>", "unknown", ""):
                        continue
                    mid = msg.get("id") or obj.get("uuid")
                    if not isinstance(mid, str) or not mid:
                        mid = (fp, ordinal)
                    timestamp = obj.get("timestamp")
                    try:
                        parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
                        stamp = parsed.timestamp() if parsed.tzinfo else float("-inf")
                    except (AttributeError, TypeError, ValueError):
                        stamp = float("-inf")
                    rank = (bool(msg.get("stop_reason")), stamp, ordinal)
                    previous = selected.get(mid)
                    if previous is None or rank > previous[0]:
                        selected[mid] = (rank, timestamp, model, project, usage)
        except OSError as exc:
            progress.warning(f"could not read {fp}: {exc}")
            add_issue(by_model["unreadable"], "unreadable transcript", "invalid_calls")
            add_issue(by_project[project], "unreadable transcript", "invalid_calls")
        finally:
            progress.advance(done_bytes=pending_bytes, parsed=1)
    progress.update(stage="Calculating costs")
    for _, timestamp, model, project, usage in selected.values():
        if not in_window(timestamp, cutoff) or (model_filter and model_filter not in model):
            continue
        key, _ = price_for(model)
        aggregates = (by_model[key], by_project[project])
        counts = [usage.get(k) for k in ("input_tokens", "cache_read_input_tokens", "output_tokens")]
        cc = usage.get("cache_creation")
        if cc is None:
            cc = {}
        invalid = None
        if not isinstance(cc, dict) or any(not integer(v) for v in counts):
            invalid = "invalid or missing token counter"
        else:
            cw5m = cc.get("ephemeral_5m_input_tokens", 0)
            cw1h = cc.get("ephemeral_1h_input_tokens", 0)
            total_write = usage.get("cache_creation_input_tokens")
            if total_write is None and cc:
                total_write = cw5m + cw1h if integer(cw5m) and integer(cw1h) else None
            if any(not integer(v) for v in (cw5m, cw1h, total_write)):
                invalid = "invalid or missing cache creation counter"
            elif cw5m + cw1h > total_write:
                invalid = "cache write duration counts exceed total writes"
        if invalid:
            for agg in aggregates:
                add_issue(agg, invalid, "invalid_calls")
            continue
        fresh_in, cache_read, out = counts
        unknown = total_write - cw5m - cw1h
        total_in = fresh_in + cache_read + total_write
        rates, assumptions, issue = rates_for("claude", key, total_in, usage)
        pin = pread = p5m = p1h = pout = 0.0
        if rates:
            pin, pread, p5m, p1h, pout = rates
        categories = {
            "fresh": (fresh_in, fresh_in * pin / 1e6),
            "cache_read": (cache_read, cache_read * pread / 1e6),
            "cache_write_5m": (cw5m, cw5m * p5m / 1e6),
            "cache_write_1h": (cw1h, cw1h * p1h / 1e6),
            "cache_write_unknown": (unknown, unknown * p5m / 1e6),
        }
        cost = sum(v[1] for v in categories.values()) + out * pout / 1e6
        naive = (total_in * pin + out * pout) / 1e6
        extra = unknown * (p1h - p5m) / 1e6
        for agg in aggregates:
            for field, value in (("calls", 1), ("fresh_in", fresh_in), ("cache_read", cache_read),
                                 ("cw5m", cw5m), ("cw1h", cw1h), ("cw_unknown", unknown),
                                 ("out", out), ("cost", cost), ("cost_intro", cost), ("naive", naive)):
                agg[field] += value
            account(agg, categories, extra, assumptions)
            if issue:
                add_issue(agg, issue)
    progress.update(stage="Preparing report")
    return by_model, by_project


def m(n):
    return f"{n / 1e6:.1f}M"


def totals(d):
    t = blank()
    for a in d.values():
        for k in ("calls", "fresh_in", "cache_read", "cw5m", "cw1h", "cw_unknown", "out", "cost", "cost_intro", "naive"):
            t[k] += a[k]
        merge_accounting(t, a)
    return t


def print_human(by_model, by_project, window_label, show_projects):
    print(f"Claude API-equivalent cost — {window_label}")
    print(f"{'model':11} {'calls':>6} {'fresh':>7} {'cache_rd':>9} {'cache_wr':>9} {'output':>7} {'cost$':>9}")
    print("-" * 66)
    for k in sorted(by_model, key=lambda x: -by_model[x]["cost"]):
        a = by_model[k]
        cw = a["cw5m"] + a["cw1h"] + a["cw_unknown"]
        print(f"{k:11} {a['calls']:>6} {m(a['fresh_in']):>7} {m(a['cache_read']):>9} "
              f"{m(cw):>9} {m(a['out']):>7} {a['cost']:>9.2f}")
    print("-" * 66)
    t = totals(by_model)
    tot_input_side = t["fresh_in"] + t["cache_read"] + t["cw5m"] + t["cw1h"] + t["cw_unknown"]
    cache_pct = 100 * t["cache_read"] / max(tot_input_side, 1)
    print(f"input-side tokens: {m(tot_input_side)}  |  cache-served: {cache_pct:.0f}%")
    print(f"TOTAL (current API token prices): ${t['cost']:,.2f}")
    print(f"Naive (no caching at all): ${t['naive']:,.2f}  → caching saved ~${t['naive'] - t['cost']:,.0f}")
    print_accounting(t)
    if show_projects:
        print("\nby project (top 12 by cost):")
        for p in sorted(by_project, key=lambda x: -by_project[x]["cost"])[:12]:
            a = by_project[p]
            print(f"  {a['cost']:>8.2f}  {p}")


def to_json(by_model, by_project, window_label, since_iso, show_projects):
    t = totals(by_model)
    tot_input_side = t["fresh_in"] + t["cache_read"] + t["cw5m"] + t["cw1h"] + t["cw_unknown"]
    out = {
        **pricing_metadata("claude"), **accounting_json(t),
        "window": window_label,
        "since_utc": since_iso,
        "total_cost_usd": round(t["cost"], 2),
        "total_cost_intro_usd": round(t["cost_intro"], 2),
        "naive_cost_usd": round(t["naive"], 2),
        "cache_saved_usd": round(t["naive"] - t["cost"], 2),
        "cache_read_pct": round(100 * t["cache_read"] / max(tot_input_side, 1), 1),
        "by_model": {
            k: {
                **accounting_json(a),
                "calls": a["calls"],
                "fresh_input": a["fresh_in"],
                "cache_read": a["cache_read"],
                "cache_write": a["cw5m"] + a["cw1h"] + a["cw_unknown"],
                "cache_write_5m": a["cw5m"],
                "cache_write_1h": a["cw1h"],
                "cache_write_unknown": a["cw_unknown"],
                "output": a["out"],
                "cost_usd": round(a["cost"], 2),
            }
            for k, a in sorted(by_model.items(), key=lambda kv: -kv[1]["cost"])
        },
    }
    if show_projects:
        out["by_project"] = {
            p: round(a["cost"], 2)
            for p, a in sorted(by_project.items(), key=lambda kv: -kv[1]["cost"])
        }
    print(json.dumps(out, indent=2))


def main():
    ap = argparse.ArgumentParser(description="Estimate Claude API-equivalent cost from session logs.")
    ap.add_argument("--days", type=int, default=3, help="look back N days (default 3)")
    ap.add_argument("--since", help="explicit start date YYYY-MM-DD (UTC); overrides --days")
    ap.add_argument("--all", action="store_true", help="no time filter (every session on disk)")
    ap.add_argument("--by-project", action="store_true", help="also break down per project dir")
    ap.add_argument("--model", help="only models whose id contains this substring")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--no-progress", action="store_true", help="suppress progress on stderr")
    ap.add_argument("--projects-dir", default=os.path.expanduser("~/.claude/projects"))
    args = ap.parse_args()

    if args.all:
        cutoff, since_iso, label = None, None, "all sessions on disk"
    elif args.since:
        cutoff = datetime.fromisoformat(args.since).replace(tzinfo=timezone.utc)
        since_iso, label = cutoff.isoformat(), f"since {args.since}"
    else:
        cutoff = datetime.now(timezone.utc) - timedelta(days=args.days)
        since_iso, label = cutoff.isoformat(), f"last {args.days} days"

    if not os.path.isdir(args.projects_dir):
        print(f"projects dir not found: {args.projects_dir}", file=sys.stderr)
        sys.exit(1)

    try:
        with Progress(enabled=not args.no_progress) as progress:
            by_model, by_project = parse(args.projects_dir, cutoff, (args.model or "").lower(),
                                         progress=progress)
    except KeyboardInterrupt:
        return 130
    if not by_model:
        print("no usage found in window", file=sys.stderr)
        sys.exit(0)

    if args.json:
        to_json(by_model, by_project, label, since_iso, args.by_project)
    else:
        print_human(by_model, by_project, label, args.by_project)


if __name__ == "__main__":
    sys.exit(main())
