#!/bin/bash
# Compatibility entry point for WorldOS v2 document sharing.
#
# PostgreSQL custody, route selection, audio rendering, and Telegram delivery
# belong to WorldOS. This wrapper deliberately owns none of them.
set -euo pipefail

client=${WORLDOS_SHARE_DOC_CLIENT:-/opt/worldos/current/plugins/worldos-communications/bin/share_doc.py}

if [[ ! -x "$client" ]]; then
  echo "error: WorldOS communications client is unavailable: $client" >&2
  echo "       select a WorldOS release containing worldos-communications" >&2
  exit 69
fi

exec "$client" "$@"
