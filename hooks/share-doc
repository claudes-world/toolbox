#!/bin/bash
# Write markdown to a timestamped file in ~/claudes-world/tmp/ and send
# a Telegram deep-link button to open it in Pocket Console.
#
# Input: markdown content via stdin (first line = title)
# Output: file path on stdout
#
# Destination is mandatory and fail-closed. There is no person-specific or
# hardcoded chat fallback. See --help below.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: <markdown on stdin> | share-doc [options]

Options:
  --to current       Send to the authoritative current WorldOS conversation.
                     Requires WORLDOS_CURRENT_BOT_ENV and
                     WORLDOS_CURRENT_CHAT_ID, or chat metadata from an inbound
                     envelope at WORLDOS_CURRENT_ENVELOPE_PATH. Fails closed.
  --chat-id ID        Telegram chat_id to send the deep-link message to.
  --thread-id ID      Forum topic message_thread_id (optional). Required when
                      explicitly targeting a forum topic with --chat-id.
  --bot-env PATH      Path to an env file holding TELEGRAM_BOT_TOKEN.
                      Required with --chat-id unless SHARE_DOC_BOT_ENV is set.
  --bot-username NAME Skip the getMe lookup and use this bot username directly
                      (informational only — the CPC deep link itself is bot-
                      agnostic; see NOTE below).
  --no-audio          Skip TTS generation; send text-only deep-link message.
  --dry-run           Resolve and print the destination, then exit without
                      reading input, generating audio, or sending anything.

Routing is the bot identity plus chat ID plus optional thread ID. None is
inferred from a personal default, the most recent Telegram message, or
CODEX_THREAD_ID. Pass exactly one of --to current or --chat-id.

NOTE on the deep link: the CPC mini-app (cpc.claude.do) validates Telegram
WebApp initData against a list of bot tokens server-side (TELEGRAM_BOT_TOKENS
in ~/.secrets/cpc.env), so the same https://cpc.claude.do/#file=... URL opens
correctly regardless of which bot's message carried the button. There is no
t.me/<bot>/app-style per-bot link to construct. The bot username is still
resolved (via getMe, cached) for logging/diagnostics and forward-compat.
EOF
}

TMPDIR="/home/claude/claudes-world/tmp"
mkdir -p "$TMPDIR"

NO_AUDIO=0
DRY_RUN=0
TO_ARG=""
CHAT_ID_ARG=""
THREAD_ID_ARG=""
BOT_ENV_ARG=""
BOT_USERNAME_ARG=""

while [ $# -gt 0 ]; do
  case "$1" in
    --no-audio) NO_AUDIO=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --to) TO_ARG="${2:-}"; shift 2 ;;
    --chat-id) CHAT_ID_ARG="${2:-}"; shift 2 ;;
    --thread-id) THREAD_ID_ARG="${2:-}"; shift 2 ;;
    --bot-env) BOT_ENV_ARG="${2:-}"; shift 2 ;;
    --bot-username) BOT_USERNAME_ARG="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "error: unknown argument: $1 (see --help)" >&2
      exit 2
      ;;
  esac
done

# Resolve and validate routing before reading Markdown or generating audio.
# `--to current` accepts only turn-scoped WorldOS metadata. It deliberately
# ignores generic TELEGRAM_* variables and any "most recent message" state,
# either of which can silently cross conversation boundaries.
if [ -n "$TO_ARG" ] && [ -n "$CHAT_ID_ARG" ]; then
  echo "error: pass exactly one destination: --to current or --chat-id ID" >&2
  exit 2
fi

if [ -n "$TO_ARG" ]; then
  if [ "$TO_ARG" != "current" ]; then
    echo "error: unsupported --to destination: $TO_ARG (only 'current' is valid)" >&2
    exit 2
  fi
  if [ -n "$THREAD_ID_ARG" ]; then
    echo "error: --thread-id cannot override authoritative --to current routing" >&2
    exit 2
  fi
  if [ -n "$BOT_ENV_ARG" ]; then
    echo "error: --bot-env cannot override authoritative --to current routing" >&2
    exit 2
  fi

  CONTEXT_BOT_ENV="${WORLDOS_CURRENT_BOT_ENV:-}"
  CONTEXT_CHAT_ID="${WORLDOS_CURRENT_CHAT_ID:-}"
  CONTEXT_THREAD_ID="${WORLDOS_CURRENT_THREAD_ID:-}"
  CONTEXT_ENVELOPE="${WORLDOS_CURRENT_ENVELOPE_PATH:-}"

  if [ -n "$CONTEXT_ENVELOPE" ]; then
    if [ ! -r "$CONTEXT_ENVELOPE" ]; then
      echo "error: WORLDOS_CURRENT_ENVELOPE_PATH is not readable: $CONTEXT_ENVELOPE" >&2
      exit 3
    fi
    ENVELOPE_CHAT_ID=$(jq -r '.conversation.chat_id // .chat_id // empty' "$CONTEXT_ENVELOPE" 2>/dev/null || true)
    ENVELOPE_THREAD_ID=$(jq -r '.conversation.thread_id // .thread_id // .raw.message_thread_id // empty' "$CONTEXT_ENVELOPE" 2>/dev/null || true)
    if [ -n "$CONTEXT_CHAT_ID" ] && [ -n "$ENVELOPE_CHAT_ID" ] && [ "$CONTEXT_CHAT_ID" != "$ENVELOPE_CHAT_ID" ]; then
      echo "error: WorldOS current chat metadata conflicts with the inbound envelope" >&2
      exit 3
    fi
    if [ -n "$CONTEXT_THREAD_ID" ] && [ -n "$ENVELOPE_THREAD_ID" ] && [ "$CONTEXT_THREAD_ID" != "$ENVELOPE_THREAD_ID" ]; then
      echo "error: WorldOS current thread metadata conflicts with the inbound envelope" >&2
      exit 3
    fi
    CONTEXT_CHAT_ID="${CONTEXT_CHAT_ID:-$ENVELOPE_CHAT_ID}"
    CONTEXT_THREAD_ID="${CONTEXT_THREAD_ID:-$ENVELOPE_THREAD_ID}"
  fi

  if [ -z "$CONTEXT_CHAT_ID" ]; then
    echo "error: --to current has no authoritative WorldOS chat context" >&2
    echo "       inject WORLDOS_CURRENT_CHAT_ID (and WORLDOS_CURRENT_THREAD_ID when applicable)," >&2
    echo "       or WORLDOS_CURRENT_ENVELOPE_PATH; otherwise pass --chat-id explicitly" >&2
    exit 3
  fi
  if [ -z "$CONTEXT_BOT_ENV" ]; then
    echo "error: --to current has no authoritative WorldOS bot identity" >&2
    echo "       inject WORLDOS_CURRENT_BOT_ENV for the bot that received this turn" >&2
    exit 3
  fi
  BOT_ENV="$CONTEXT_BOT_ENV"
  CHAT_ID="$CONTEXT_CHAT_ID"
  THREAD_ID="$CONTEXT_THREAD_ID"
elif [ -n "$CHAT_ID_ARG" ]; then
  BOT_ENV="${BOT_ENV_ARG:-${SHARE_DOC_BOT_ENV:-}}"
  if [ -z "$BOT_ENV" ]; then
    echo "error: explicit chat routing also requires --bot-env PATH or SHARE_DOC_BOT_ENV" >&2
    exit 3
  fi
  CHAT_ID="$CHAT_ID_ARG"
  THREAD_ID="$THREAD_ID_ARG"
else
  echo "error: no destination; pass --to current or --chat-id ID" >&2
  echo "       share-doc has no default sending route" >&2
  exit 3
fi

if [ "$DRY_RUN" -eq 1 ]; then
  echo "destination: bot-env=${BOT_ENV} chat=${CHAT_ID}${THREAD_ID:+ thread=$THREAD_ID}"
  exit 0
fi

INPUT=$(cat)

# Trim leading/trailing whitespace for path detection
TRIMMED=$(echo "$INPUT" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')

# Mode detection: if input is a single line that is an existing .md file, share that file directly
if [ "$(echo "$TRIMMED" | wc -l)" -eq 1 ] && echo "$TRIMMED" | grep -qE '^/.+\.md$' && [ -f "$TRIMMED" ]; then
  # --- Mode 2: Share existing file ---
  FILEPATH="$TRIMMED"

  # CPC (Pocket Console) reads files only from $TMPDIR (~/claudes-world/tmp).
  # Paths outside that produce a dead deep-link, and audio generated next to
  # the file is also unreachable. Reject loudly rather than fail silently.
  case "$FILEPATH" in
    "$TMPDIR"/*) ;;
    *)
      echo "error: file must live under $TMPDIR for CPC to read it" >&2
      echo "       got: $FILEPATH" >&2
      echo "       move it (e.g. mv \"$FILEPATH\" \"$TMPDIR/\") and retry" >&2
      exit 2
      ;;
  esac

  # WORLD-363: group-chat sends resolve the doc via its timestamp filename
  # prefix (startapp token). Reject a non-conforming name BEFORE paying for
  # TTS below — the send-time button construction would fail on it anyway.
  case "$CHAT_ID" in
    -*)
      if ! basename "$FILEPATH" | grep -qE '^[0-9]{8}-[0-9]{6}-.*\.md$'; then
        echo "error: group-chat share needs a timestamp-prefixed filename (YYYYMMDD-HHMMSS-<slug>.md) so CPC can resolve the startapp token" >&2
        echo "       got: $(basename "$FILEPATH") — rename it under $TMPDIR (e.g. \$(TZ=America/New_York date +%Y%m%d-%H%M%S)-name.md) and retry" >&2
        exit 2
      fi
      ;;
  esac

  TITLE=$(head -1 "$FILEPATH" | sed 's/^#* *//')

  if [ "$NO_AUDIO" -eq 0 ]; then
    AUDIOPATH="${FILEPATH%.md}.mp3"

    # Generate audio if it doesn't already exist
    if [ ! -f "$AUDIOPATH" ] || [ ! -s "$AUDIOPATH" ]; then
      /home/claude/bin/md-speak --no-describe --out "$AUDIOPATH" "$FILEPATH" 2>/dev/null || true
    fi
  fi
else
  # --- Mode 1: Create temp file from inline content ---
  # First line is the title (strip leading # if present)
  TITLE=$(echo "$INPUT" | head -1 | sed 's/^#* *//')
  BODY=$(echo "$INPUT" | tail -n +2)

  if [ -z "$TITLE" ]; then
    echo "error: no title (first line empty)" >&2
    exit 1
  fi

  # Slugify title for filename
  SLUG=$(echo "$TITLE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//' | cut -c1-60)
  TIMESTAMP=$(TZ=America/New_York date +%Y%m%d-%H%M%S)
  FILENAME="${TIMESTAMP}-${SLUG}.md"
  FILEPATH="${TMPDIR}/${FILENAME}"

  # Write file — ensure H1 title
  echo "# ${TITLE}" > "$FILEPATH"
  echo "" >> "$FILEPATH"
  echo "$BODY" >> "$FILEPATH"

  if [ "$NO_AUDIO" -eq 0 ]; then
    # Generate audio version
    AUDIOPATH="${FILEPATH%.md}.mp3"
    /home/claude/bin/md-speak --no-describe --out "$AUDIOPATH" "$FILEPATH" 2>/dev/null || true
  fi
fi

# --- Sender credential resolution ---
# Bot identity and conversation routing were already resolved and validated
# before any expensive work.

BOTTOKEN=""
if [ -f "$BOT_ENV" ]; then
  BOTTOKEN=$(grep -E '^TELEGRAM_BOT_TOKEN=' "$BOT_ENV" 2>/dev/null | head -1 | cut -d= -f2-)
fi
BOTTOKEN="${BOTTOKEN:-${TELEGRAM_BOT_TOKEN:-}}"

# Fail loudly so the caller knows the deep-link was never sent — silent
# no-ops mask the problem.
if [ -z "$BOTTOKEN" ]; then
  echo "error: no bot token found (checked $BOT_ENV, then \$TELEGRAM_BOT_TOKEN; pass --bot-env or --help)" >&2
  exit 3
fi
if [ -z "$CHAT_ID" ]; then
  echo "error: no chat_id after explicit destination resolution" >&2
  exit 3
fi

# Resolve the bot's @username via getMe, cached per bot-env path so routine
# sends don't pay for an extra API round-trip. Informational only (see NOTE
# in --help) — the deep link itself doesn't need it — but derived from the
# token rather than ever hardcoded, per the fix requested.
resolve_bot_username() {
  local token="$1" env_path="$2"
  local cache_dir="/home/claude/.cache/share-doc"
  mkdir -p "$cache_dir" 2>/dev/null || true
  local key cache_file
  key=$(printf '%s' "$env_path" | md5sum | cut -d' ' -f1)
  cache_file="${cache_dir}/${key}.username"
  if [ -s "$cache_file" ]; then
    cat "$cache_file"
    return 0
  fi
  local uname
  uname=$(curl -s --max-time 5 "https://api.telegram.org/bot${token}/getMe" 2>/dev/null | jq -r '.result.username // empty' 2>/dev/null || true)
  if [ -n "$uname" ]; then
    printf '%s' "$uname" > "$cache_file" 2>/dev/null || true
    printf '%s' "$uname"
  fi
}

BOT_USERNAME="${BOT_USERNAME_ARG:-$(resolve_bot_username "$BOTTOKEN" "$BOT_ENV")}"
if [ -n "$BOT_USERNAME" ]; then
  echo "info: share-doc sending as @${BOT_USERNAME} → chat=${CHAT_ID}${THREAD_ID:+ thread=$THREAD_ID} (bot-env: $BOT_ENV)" >&2
else
  echo "warning: could not resolve bot username via getMe (bot-env: $BOT_ENV) — sending anyway" >&2
fi

# Extra curl -F args for forum-topic targeting; empty (no-op) when unset.
THREAD_FORM_ARGS=()
if [ -n "$THREAD_ID" ]; then
  THREAD_FORM_ARGS=(-F "message_thread_id=${THREAD_ID}")
fi

if [ -n "$BOTTOKEN" ] && [ -n "$CHAT_ID" ]; then
  ENCODED_PATH=$(python3 -c "from urllib.parse import quote; print(quote('${FILEPATH}'))")
  DEEP_URL="https://cpc.claude.do/#file=${ENCODED_PATH}"

  # WORLD-363: Telegram rejects web_app inline buttons in group/supergroup
  # chats (BUTTON_TYPE_INVALID) — they only work in private chats. Negative
  # chat ids (groups/supergroups/channels) therefore get a plain url button
  # that opens the CPC mini-app via the `files` short name registered on
  # @claude_dobot, carrying the file's timestamp prefix as the startapp
  # token; CPC's bootstrap rewrites `f_<ts>` back to the same #file= route
  # client-side (fail-closed, jailed to $TMPDIR). DMs keep the web_app
  # button unchanged.
  case "$CHAT_ID" in
    -*)
      TS_PREFIX=$(basename "$FILEPATH" | sed -nE 's/^([0-9]{8}-[0-9]{6})-.*\.md$/\1/p')
      if [ -z "$TS_PREFIX" ]; then
        echo "error: group-chat share needs a timestamp-prefixed filename (YYYYMMDD-HHMMSS-<slug>.md) so CPC can resolve the startapp token" >&2
        echo "       got: $(basename "$FILEPATH") — rename it under $TMPDIR (e.g. \$(TZ=America/New_York date +%Y%m%d-%H%M%S)-name.md) and retry" >&2
        exit 2
      fi
      REPLY_MARKUP=$(jq -nc \
        --arg url "https://t.me/claude_dobot/files?startapp=f_${TS_PREFIX}" \
        '{inline_keyboard: [[{text: "Read in Pocket Console", url: $url}]]}')
      ;;
    *)
      REPLY_MARKUP=$(jq -nc \
        --arg url "$DEEP_URL" \
        '{inline_keyboard: [[{text: "Read in Pocket Console", web_app: {url: $url}}]]}')
      ;;
  esac

  # Telegram bot sendAudio caps uploads at ~50MB. Long docs (1000+ lines)
  # can produce mp3s well above that — chop into ~25min segments via ffmpeg
  # so each part lands under the cap. Deep-link button only on the final
  # part (so the user reaches the doc reader after they've finished
  # listening, and the chat doesn't get N button-laden notifications).
  AUDIO_SIZE_THRESHOLD=$((48 * 1024 * 1024))
  AUDIO_SIZE=0
  if [ "$NO_AUDIO" -eq 0 ] && [ -n "${AUDIOPATH:-}" ] && [ -f "$AUDIOPATH" ] && [ -s "$AUDIOPATH" ]; then
    AUDIO_SIZE=$(stat -c %s "$AUDIOPATH" 2>/dev/null || echo 0)
  fi

  if [ "$NO_AUDIO" -eq 0 ] && [ -n "${AUDIOPATH:-}" ] && [ -f "$AUDIOPATH" ] && [ -s "$AUDIOPATH" ] && [ "$AUDIO_SIZE" -gt "$AUDIO_SIZE_THRESHOLD" ]; then
    # --- Multi-part send: chop via ffmpeg, deep-link on final part ---
    SEG_DIR=$(mktemp -d -t share-doc-segs.XXXXXX)
    trap 'rm -rf "$SEG_DIR"' EXIT INT TERM
    # stream-copy split keeps the existing mp3 encoding; ~25min per segment
    # at typical TTS bitrate (~32kbps) is ~6MB/part — well under the 50MB
    # cap with margin, and produces far fewer chunks than the prior 8min
    # split (e.g. 9 parts → ~3 parts for an hour-long report).
    ffmpeg -nostdin -loglevel error -i "$AUDIOPATH" \
      -f segment -segment_time 1500 -c copy -reset_timestamps 1 \
      "${SEG_DIR}/part_%03d.mp3" 2>/dev/null
    shopt -s nullglob
    PARTS=("$SEG_DIR"/part_*.mp3)
    TOTAL=${#PARTS[@]}
    MSG_ID=""
    if [ "$TOTAL" -eq 0 ]; then
      # ffmpeg failed; fall back to deep-link-only sendMessage (audio omitted)
      curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
        -H "Content-Type: application/json" \
        -d "$(jq -n \
          --arg cid "$CHAT_ID" \
          --arg title "📄 ${TITLE} (audio chop failed — text only)" \
          --argjson rm "$REPLY_MARKUP" \
          --arg tid "$THREAD_ID" \
          '{chat_id: $cid, text: $title, reply_markup: $rm}
           + (if $tid != "" then {message_thread_id: ($tid|tonumber)} else {} end)'
        )" > "$TMPDIR/.last-send-response.json" 2>&1 || true
      MSG_ID=$(jq -r '.result.message_id // empty' "$TMPDIR/.last-send-response.json" 2>/dev/null || true)
    else
      for i in "${!PARTS[@]}"; do
        PART="${PARTS[$i]}"
        NUM=$((i + 1))
        PART_TITLE="${TITLE} — part ${NUM}/${TOTAL}"
        if [ "$NUM" -eq "$TOTAL" ]; then
          # Final part — attach the deep-link button
          curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendAudio" \
            -F "chat_id=${CHAT_ID}" \
            -F "audio=@${PART}" \
            -F "title=${PART_TITLE}" \
            -F "caption=📄 ${PART_TITLE}" \
            -F "reply_markup=${REPLY_MARKUP}" \
            -F "disable_notification=true" \
            "${THREAD_FORM_ARGS[@]}" \
            > "$TMPDIR/.last-send-response.json" 2>&1 || true
          MSG_ID=$(jq -r '.result.message_id // empty' "$TMPDIR/.last-send-response.json" 2>/dev/null || true)
        else
          # Intermediate part — no button, just the audio
          curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendAudio" \
            -F "chat_id=${CHAT_ID}" \
            -F "audio=@${PART}" \
            -F "title=${PART_TITLE}" \
            -F "caption=📄 ${PART_TITLE}" \
            -F "disable_notification=true" \
            "${THREAD_FORM_ARGS[@]}" \
            > /dev/null 2>&1 || true
        fi
      done
    fi
  elif [ "$NO_AUDIO" -eq 0 ] && [ -n "${AUDIOPATH:-}" ] && [ -f "$AUDIOPATH" ] && [ -s "$AUDIOPATH" ]; then
    # Send audio with inline keyboard button for deep link
    curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendAudio" \
      -F "chat_id=${CHAT_ID}" \
      -F "audio=@${AUDIOPATH}" \
      -F "title=${TITLE}" \
      -F "caption=📄 ${TITLE}" \
      -F "reply_markup=${REPLY_MARKUP}" \
      -F "disable_notification=true" \
      "${THREAD_FORM_ARGS[@]}" \
      > "$TMPDIR/.last-send-response.json" 2>&1 || true
    MSG_ID=$(jq -r '.result.message_id // empty' "$TMPDIR/.last-send-response.json" 2>/dev/null || true)
  else
    # Fallback: text message with inline button (no audio)
    curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
      -H "Content-Type: application/json" \
      -d "$(jq -n \
        --arg cid "$CHAT_ID" \
        --arg title "📄 ${TITLE}" \
        --argjson rm "$REPLY_MARKUP" \
        --arg tid "$THREAD_ID" \
        '{
          chat_id: $cid,
          text: $title,
          reply_markup: $rm
        } + (if $tid != "" then {message_thread_id: ($tid|tonumber)} else {} end)'
      )" > "$TMPDIR/.last-send-response.json" 2>&1 || true
    MSG_ID=$(jq -r '.result.message_id // empty' "$TMPDIR/.last-send-response.json" 2>/dev/null || true)
  fi

  # Fail LOUDLY if the send didn't land (2026-07-14: two group-topic sends
  # failed silently with BUTTON_TYPE_INVALID — Telegram rejects web_app
  # inline buttons in group/supergroup chats; they only work in private
  # chats, which is why the default DM target has always worked).
  if [ -z "$MSG_ID" ]; then
    SEND_ERR=$(jq -r '.description // "unknown error"' "$TMPDIR/.last-send-response.json" 2>/dev/null || echo "unknown error")
    echo "error: telegram send FAILED (${SEND_ERR}) — chat=${CHAT_ID}${THREAD_ID:+ thread=$THREAD_ID}" >&2
    if [ "${SEND_ERR}" = "Bad Request: BUTTON_TYPE_INVALID" ]; then
      echo "hint: web_app buttons are rejected in group chats. Group chat ids (-100…) should have taken the url-button path (WORLD-363) — if you see this, that switch misfired; report it." >&2
    fi
    rm -f "$TMPDIR/.last-send-response.json"
    exit 1
  fi

  # Auto-pin the shared document message (warn on failure, don't abort)
  PIN_RESP=$(curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/pinChatMessage" \
    -d "chat_id=${CHAT_ID}&message_id=${MSG_ID}&disable_notification=true" 2>/dev/null || true)
  if [ "$(printf '%s' "$PIN_RESP" | jq -r '.ok // false' 2>/dev/null)" != "true" ]; then
    echo "warning: auto-pin failed: $(printf '%s' "$PIN_RESP" | jq -r '.description // "no response"' 2>/dev/null)" >&2
  fi
  rm -f "$TMPDIR/.last-send-response.json"
fi

echo "$FILEPATH"
