#!/bin/bash
# Hook for SubagentStart: notify Telegram and track agent in JSON file
set -euo pipefail

# shellcheck source=../lib/otel.sh
_OTEL_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/../lib/otel.sh"
{ [ -f "$_OTEL_LIB" ] && source "$_OTEL_LIB" && otel_start_span "${0##*/}" && trap 'otel_end_span $?' EXIT; } || true

INPUT=$(cat)
TRACKER="/tmp/agent-tracker.json"

# Log raw input so we can see what fields are available
echo "=== agent-start $(date) ===" >> /tmp/agent-hooks.log
echo "$INPUT" | head -c 1000 >> /tmp/agent-hooks.log
echo "" >> /tmp/agent-hooks.log

# Telegram notifications DISABLED 2026-07-06 per Liam (voice msg 26585): the
# per-subagent start/stop messages cluttered the chat and buried real conversation.
# The debug log line above is kept; the Telegram send below is skipped.
# Re-enable by removing this exit 0 (the SubagentStart hook was also removed from
# claudes-world/.claude/settings.json — re-add it there too).
exit 0

# Fields available: agent_id, agent_type, session_id, cwd, hook_event_name
AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // empty' 2>/dev/null || true)
AGENT_TYPE=$(echo "$INPUT" | jq -r '.agent_type // "agent"' 2>/dev/null || true)
AGENT_SHORT="${AGENT_ID:0:8}"
TIMESTAMP=$(TZ=America/New_York date '+%-I:%M %p ET')

HOOK_CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || true)
. "$(dirname "$(readlink -f "$0")")/wos-hook-target.sh"
wos_hook_target
CHAT_ID="$TELEGRAM_CHAT_ID"
[ -z "$BOTTOKEN" ] && exit 0
require_chat_id || exit 0

# Build message
NL=$'\n'
MSG="🚀 <b>agent-${AGENT_SHORT}</b> (${AGENT_TYPE})${NL}🕐 ${TIMESTAMP}"

# Send to Telegram (silent)
RESPONSE=$(curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
  -H "Content-Type: application/json" \
  -d "$(jq -n \
    --arg cid "$CHAT_ID" \
    --arg text "$MSG" \
    '{chat_id: $cid, text: $text, parse_mode: "HTML", disable_notification: true}'
  )" 2>/dev/null || true)

# Extract message_id from response
MSG_ID=$(echo "$RESPONSE" | jq -r '.result.message_id // empty' 2>/dev/null || true)

# Update tracker JSON
if [ -n "$AGENT_ID" ] && [ -n "$MSG_ID" ]; then
  # Create tracker if it doesn't exist
  [ ! -f "$TRACKER" ] && echo '{}' > "$TRACKER"

  # Add/update entry
  jq --arg id "$AGENT_ID" \
     --arg msg_id "$MSG_ID" \
     --arg type "$AGENT_TYPE" \
     --arg started "$TIMESTAMP" \
     '.[$id] = {msg_id: ($msg_id | tonumber), type: $type, started: $started, status: "running"}' \
     "$TRACKER" > "${TRACKER}.tmp" && mv "${TRACKER}.tmp" "$TRACKER"
fi
