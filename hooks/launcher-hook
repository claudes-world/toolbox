#!/bin/bash
# Hook script for SessionStart: restore the web_app keyboard launcher
# Also initializes .active-chat if it doesn't exist yet.

set -euo pipefail

INPUT=$(cat 2>/dev/null || true)
HOOK_CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || true)
HOOK_CWD="${HOOK_CWD:-$(pwd)}"

. "$(dirname "$(readlink -f "$0")")/common.sh"

[ -z "$BOTTOKEN" ] && exit 0
[ -z "$TELEGRAM_CHAT_ID" ] && exit 0

CHAT_ID="$TELEGRAM_CHAT_ID"

# Initialize .active-chat if it doesn't exist
ACTIVE_CHAT="${HOOK_CWD}/.claude/.active-chat"
if [ ! -f "$ACTIVE_CHAT" ] && [ -d "${HOOK_CWD}/.claude" ]; then
  echo "$CHAT_ID" > "$ACTIVE_CHAT"
fi

curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
  -H "Content-Type: application/json" \
  -d "{
    \"chat_id\": \"${CHAT_ID}\",
    \"text\": \"Session started.\",
    \"reply_markup\": {
      \"keyboard\": [
        [
          {\"text\": \"🖥 Console\", \"web_app\": {\"url\": \"https://cpc.claude.do/#terminal\"}},
          {\"text\": \"📁 Files\", \"web_app\": {\"url\": \"https://cpc.claude.do/#files\"}}
        ],
        [
          {\"text\": \"📚 Knowledge\", \"web_app\": {\"url\": \"https://cpc.claude.do/#files\"}},
          {\"text\": \"⚡ Actions\"}
        ]
      ],
      \"resize_keyboard\": true,
      \"is_persistent\": true
    }
  }" > /dev/null 2>&1 || true
