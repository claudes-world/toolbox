#!/bin/bash
# Hook script for UserPromptSubmit: handle Actions keyboard button taps
# Detects action button texts and executes them, sending results via Telegram.
# Also sends the actions menu when "Actions" is tapped.

set -euo pipefail

INPUT=$(cat)
CONTENT=$(echo "$INPUT" | jq -r '.prompt // .message.content // ""' 2>/dev/null || true)

# Load bot token
BOTTOKEN=$(grep TELEGRAM_BOT_TOKEN /home/claude/.claude/channels/telegram/.env 2>/dev/null | cut -d= -f2)
[ -z "$BOTTOKEN" ] && exit 0

CHAT_ID="1676859445"

send_msg() {
  local text="$1"
  local parse_mode="${2:-}"
  local markup="${3:-}"
  local data
  if [ -n "$markup" ]; then
    data=$(jq -n --arg cid "$CHAT_ID" --arg txt "$text" --argjson rm "$markup" \
      '{chat_id: $cid, text: $txt, reply_markup: $rm}')
  else
    data=$(jq -n --arg cid "$CHAT_ID" --arg txt "$text" '{chat_id: $cid, text: $txt}')
  fi
  if [ -n "$parse_mode" ]; then
    data=$(echo "$data" | jq --arg pm "$parse_mode" '. + {parse_mode: $pm}')
  fi
  curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
    -H "Content-Type: application/json" -d "$data" > /dev/null 2>&1 || true
}

ACTIONS_INLINE='{"inline_keyboard":[[{"text":"📊 Usage (7d)","callback_data":"usage_7d"},{"text":"📊 Usage (30d)","callback_data":"usage_30d"}],[{"text":"📋 Git Status","callback_data":"git_status"},{"text":"🔄 Reload Plugins","callback_data":"reload_plugins"}]]}'

case "$CONTENT" in
  *"⚡ Actions"*)
    send_msg "Choose an action:" "" "$ACTIONS_INLINE"
    echo '{"suppressOutput":true}'
    ;;
  *"usage_7d"*)
    /home/claude/bin/openai-usage --days 7 --telegram 2>/dev/null || send_msg "Failed to fetch usage"
    echo '{"suppressOutput":true}'
    ;;
  *"usage_30d"*)
    /home/claude/bin/openai-usage --days 30 --telegram 2>/dev/null || send_msg "Failed to fetch usage"
    echo '{"suppressOutput":true}'
    ;;
  *"git_status"*)
    OUTPUT=$(cd /home/claude/claudes-world && git status --short 2>&1)
    if [ -z "$OUTPUT" ]; then
      OUTPUT="Working tree clean"
    fi
    send_msg "<pre>${OUTPUT}</pre>" "HTML"
    echo '{"suppressOutput":true}'
    ;;
  *"reload_plugins"*)
    # Let Claude handle this one
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
