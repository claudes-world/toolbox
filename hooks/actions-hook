#!/bin/bash
# Hook script for UserPromptSubmit: handle Actions keyboard button taps
# Shows a one-time reply keyboard for actions, executes them, then restores launcher.

set -euo pipefail

INPUT=$(cat)
CONTENT=$(echo "$INPUT" | jq -r '.prompt // .message.content // ""' 2>/dev/null || true)

# Load bot token
BOTTOKEN=$(grep TELEGRAM_BOT_TOKEN /home/claude/.claude/channels/telegram/.env 2>/dev/null | cut -d= -f2)
[ -z "$BOTTOKEN" ] && exit 0

HOOK_CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || true)
. "$(dirname "$(readlink -f "$0")")/common.sh"
CHAT_ID="$TELEGRAM_CHAT_ID"

send_msg() {
  local text="$1"
  local parse_mode="${2:-}"
  local markup="${3:-}"
  local data
  if [ -n "$markup" ]; then
    data=$(jq -n --arg cid "$CHAT_ID" --arg txt "$text" --argjson rm "$markup" \
      '{chat_id: $cid, text: $txt, reply_markup: $rm}')
  else
    data=$(jq -n --arg cid "$CHAT_ID" --arg txt "$text" '{chat_id: $cid, text: $txt}')
  fi
  if [ -n "$parse_mode" ]; then
    data=$(echo "$data" | jq --arg pm "$parse_mode" '. + {parse_mode: $pm}')
  fi
  curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
    -H "Content-Type: application/json" -d "$data" > /dev/null 2>&1 || true
}

ACTIONS_MENU='{"keyboard":[[{"text":"📊 Usage (7d)"},{"text":"📊 Usage (30d)"}],[{"text":"📋 Git Status"},{"text":"🔄 Reload Plugins"}]],"resize_keyboard":true,"one_time_keyboard":true}'

LAUNCHER='{"keyboard":[[{"text":"🖥 Console","web_app":{"url":"https://cpc.claude.do/#terminal"}},{"text":"📁 Files","web_app":{"url":"https://cpc.claude.do/#files"}}],[{"text":"📚 Knowledge","web_app":{"url":"https://cpc.claude.do/#files"}},{"text":"⚡ Actions"}],[{"text":"🧪 Dev Console","web_app":{"url":"https://cpc-dev.claude.do/#terminal"}}]],"resize_keyboard":true,"is_persistent":true}'

case "$CONTENT" in
  *"⚡ Actions"*)
    send_msg "Choose an action:" "" "$ACTIONS_MENU"
    echo '{"suppressOutput":true}'
    ;;
  *"📊 Usage (7d)"*)
    send_msg "Fetching 7-day usage..."
    /home/claude/bin/openai-usage --days 7 --telegram 2>/dev/null || send_msg "Failed to fetch usage"
    send_msg "Done." "" "$LAUNCHER"
    echo '{"suppressOutput":true}'
    ;;
  *"📊 Usage (30d)"*)
    send_msg "Fetching 30-day usage..."
    /home/claude/bin/openai-usage --days 30 --telegram 2>/dev/null || send_msg "Failed to fetch usage"
    send_msg "Done." "" "$LAUNCHER"
    echo '{"suppressOutput":true}'
    ;;
  *"📋 Git Status"*)
    OUTPUT=$(cd /home/claude/claudes-world && git status --short 2>&1)
    if [ -z "$OUTPUT" ]; then
      OUTPUT="Working tree clean"
    fi
    send_msg "<pre>${OUTPUT}</pre>" "HTML"
    send_msg "Done." "" "$LAUNCHER"
    echo '{"suppressOutput":true}'
    ;;
  *"🔄 Reload Plugins"*)
    # Restore launcher then let Claude handle the reload
    send_msg "Reloading..." "" "$LAUNCHER"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
