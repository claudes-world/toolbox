#!/bin/bash
# Hook for SubagentStop: notify Telegram (threaded) and update tracker
set -euo pipefail

INPUT=$(cat)
TRACKER="/tmp/agent-tracker.json"

echo "=== agent-stop $(date) ===" >> /tmp/agent-hooks.log
echo "$INPUT" | head -c 1000 >> /tmp/agent-hooks.log
echo "" >> /tmp/agent-hooks.log

# Fields: agent_id, agent_type, last_assistant_message, agent_transcript_path
AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // empty' 2>/dev/null || true)
AGENT_TYPE_RAW=$(echo "$INPUT" | jq -r '.agent_type // empty' 2>/dev/null || true)

# Filter Claude Code internal sidechains (suggestion / compact / idle / Plan-mode
# auto-fired agents) — they emit SubagentStop with empty agent_type and have NO
# corresponding SubagentStart. Per memory `feedback_cc_internal_sidechains_emit_subagentstop`
# + Liam directive 2026-06-05 msg 21099. ~90% of SubagentStops in /tmp/agent-hooks.log
# (2372 of 2559 in one sample) are these internal events. Filtering empty agent_type
# keeps named agents (general-purpose, web-researcher, code-review-*, super-swarm-orchestrator,
# Explore, etc.) while muting the spam.
if [ -z "$AGENT_TYPE_RAW" ]; then
  echo "skip: empty agent_type (CC internal sidechain) id=${AGENT_ID:0:8}" >> /tmp/agent-hooks.log
  exit 0
fi
AGENT_TYPE="$AGENT_TYPE_RAW"
AGENT_SHORT="${AGENT_ID:0:8}"
# Per Gemini review: `head -c 2000` truncates by BYTES, which can split multi-byte
# UTF-8 characters (emoji, CJK, accents) mid-byte and produce invalid UTF-8 that
# Telegram's API rejects with HTTP 400. Use Python string slicing for UTF-8-safe
# truncation by character count (Telegram's text limit is in characters, not bytes).
LAST_MSG=$(echo "$INPUT" | jq -r '.last_assistant_message // empty' 2>/dev/null | python3 -c "import sys; sys.stdout.write(sys.stdin.read()[:2000])" || true)
TIMESTAMP=$(TZ=America/New_York date '+%-I:%M %p ET')

HOOK_CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || true)
. "$(dirname "$(readlink -f "$0")")/common.sh"
CHAT_ID="$TELEGRAM_CHAT_ID"
[ -z "$BOTTOKEN" ] && exit 0
require_chat_id || exit 0

# Look up the start message_id from tracker
REPLY_TO=""
if [ -n "$AGENT_ID" ] && [ -f "$TRACKER" ]; then
  REPLY_TO=$(jq -r --arg id "$AGENT_ID" '.[$id].msg_id // empty' "$TRACKER" 2>/dev/null || true)
fi

# Build message with real newlines
NL=$'\n'
MSG="✅ <b>agent-${AGENT_SHORT}</b> finished${NL}🕐 ${TIMESTAMP}"
[ -n "$LAST_MSG" ] && MSG="${MSG}${NL}<blockquote expandable>📝 ${LAST_MSG}</blockquote>"

# Send to Telegram (threaded under start message if possible, silent)
SEND_DATA=$(jq -n \
  --arg cid "$CHAT_ID" \
  --arg text "$MSG" \
  '{chat_id: $cid, text: $text, parse_mode: "HTML", disable_notification: true}')

if [ -n "$REPLY_TO" ]; then
  SEND_DATA=$(echo "$SEND_DATA" | jq --arg rt "$REPLY_TO" '. + {reply_to_message_id: ($rt | tonumber)}')
fi

curl -s -X POST "https://api.telegram.org/bot${BOTTOKEN}/sendMessage" \
  -H "Content-Type: application/json" \
  -d "$SEND_DATA" > /dev/null 2>&1 || true

# Update tracker
if [ -n "$AGENT_ID" ] && [ -f "$TRACKER" ]; then
  jq --arg id "$AGENT_ID" \
     --arg finished "$TIMESTAMP" \
     'if .[$id] then .[$id].status = "done" | .[$id].finished = $finished else . end' \
     "$TRACKER" > "${TRACKER}.tmp" && mv "${TRACKER}.tmp" "$TRACKER"
fi
