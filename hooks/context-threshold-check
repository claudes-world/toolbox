#!/bin/bash
# context-threshold-check
#
# UserPromptSubmit hook for pre-compact preparation nudges.
# Reads the active transcript JSONL, estimates context utilization from the
# last assistant usage object, and injects one advisory per threshold.

set +e

STATE_ROOT="${CONTEXT_THRESHOLD_STATE_DIR:-/home/claude/.claude/context-threshold-state}"
MESSAGE_DIR="${CONTEXT_THRESHOLD_MESSAGE_DIR:-/home/claude/.claude/context-threshold-messages}"
TAIL_LINES="${CONTEXT_THRESHOLD_TAIL_LINES:-200}"
JQ_TIMEOUT_SECONDS="${CONTEXT_THRESHOLD_JQ_TIMEOUT_SECONDS:-0.06}"
DEFAULT_CONTEXT_WINDOW="${CONTEXT_THRESHOLD_CONTEXT_WINDOW:-200000}"
EXTENDED_CONTEXT_WINDOW="${CONTEXT_THRESHOLD_EXTENDED_CONTEXT_WINDOW:-1000000}"

emit_empty() {
  printf '{}\n'
  exit 0
}

valid_int() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

default_message() {
  case "$1" in
    80)
      printf '%s\n' 'Context threshold 80% crossed: acknowledge via Telegram, then update skills/AGENTS.md/memory with session learnings and include as much information as possible in NEXT-SESSION.md (append, do not prune). Then KEEP WORKING — the hook is a preparation signal, not a stop signal.'
      ;;
    90)
      printf '%s\n' 'Context threshold 90% crossed: verify 80% capture is fresh, add any NEW details to NEXT-SESSION.md without rewriting or pruning existing content. Keep dispatching small safe work; finish in-flight before starting new.'
      ;;
    95)
      printf '%s\n' 'Context threshold 95% crossed: imminent auto-compact. Add new actionable state to NEXT-SESSION.md but KEEP all details added previously. Append in-flight agent IDs, worktree paths, blocked items, resume-first priorities. NEXT-SESSION is append-only from the 80% capture forward — do not rewrite or prune.'
      ;;
  esac
}

read_message() {
  threshold="$1"
  message_file="${MESSAGE_DIR}/${threshold}.txt"
  if [ -r "$message_file" ]; then
    cat "$message_file" 2>/dev/null
  else
    default_message "$threshold"
  fi
}

emit_advisory() {
  threshold="$1"
  message="$(read_message "$threshold")"
  [ -n "$message" ] || emit_empty

  additional_context="${message}

Context utilization estimate: ${PERCENT}% (${USED_TOKENS}/${CONTEXT_WINDOW} input tokens). Generated by /home/claude/bin/context-threshold-check."

  jq -n --arg msg "$additional_context" \
    '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$msg}}' 2>/dev/null || printf '{}\n'
  exit 0
}

command -v jq >/dev/null 2>&1 || emit_empty

INPUT="$(cat 2>/dev/null)"
PAYLOAD_TSV="$(printf '%s' "$INPUT" | jq -r '[.hook_event_name // "UserPromptSubmit", .transcript_path // "", .session_id // ""] | @tsv' 2>/dev/null)"
[ -n "$PAYLOAD_TSV" ] || emit_empty

IFS="$(printf '\t')" read -r HOOK_EVENT_NAME TRANSCRIPT_PATH SESSION_ID <<EOF
$PAYLOAD_TSV
EOF

[ -n "$HOOK_EVENT_NAME" ] || HOOK_EVENT_NAME="UserPromptSubmit"
[ -n "$TRANSCRIPT_PATH" ] || TRANSCRIPT_PATH="${CLAUDE_TRANSCRIPT_PATH:-${TRANSCRIPT_PATH_ENV:-}}"
[ -n "$SESSION_ID" ] || SESSION_ID="$(basename "$TRANSCRIPT_PATH" .jsonl 2>/dev/null)"
[ -n "$SESSION_ID" ] || SESSION_ID="unknown"

SESSION_KEY="$(printf '%s' "$SESSION_ID" | tr -cd '[:alnum:]._-')"
[ -n "$SESSION_KEY" ] || SESSION_KEY="unknown"
SESSION_DIR="${STATE_ROOT}/${SESSION_KEY}"

if [ "$HOOK_EVENT_NAME" = "SessionEnd" ]; then
  rm -rf "$SESSION_DIR" 2>/dev/null
  emit_empty
fi

[ "$HOOK_EVENT_NAME" = "UserPromptSubmit" ] || emit_empty
[ -r "$TRANSCRIPT_PATH" ] || emit_empty

USAGE_TSV="$(
  timeout "$JQ_TIMEOUT_SECONDS" bash -c '
    tail -n "$1" -- "$2" 2>/dev/null |
      jq -r '"'"'select(.type=="assistant" and .message.usage) |
        [
          (.message.model // ""),
          (.message.usage.input_tokens // 0),
          (.message.usage.cache_read_input_tokens // 0),
          (.message.usage.cache_creation_input_tokens // 0)
        ] | @tsv'"'"' 2>/dev/null |
      tail -n 1
  ' _ "$TAIL_LINES" "$TRANSCRIPT_PATH" 2>/dev/null
)"

[ -n "$USAGE_TSV" ] || emit_empty

IFS="$(printf '\t')" read -r MODEL INPUT_TOKENS CACHE_READ_TOKENS CACHE_CREATION_TOKENS <<EOF
$USAGE_TSV
EOF

valid_int "$INPUT_TOKENS" || INPUT_TOKENS=0
valid_int "$CACHE_READ_TOKENS" || CACHE_READ_TOKENS=0
valid_int "$CACHE_CREATION_TOKENS" || CACHE_CREATION_TOKENS=0
valid_int "$DEFAULT_CONTEXT_WINDOW" || DEFAULT_CONTEXT_WINDOW=200000
valid_int "$EXTENDED_CONTEXT_WINDOW" || EXTENDED_CONTEXT_WINDOW=1000000

USED_TOKENS=$((INPUT_TOKENS + CACHE_READ_TOKENS + CACHE_CREATION_TOKENS))
CONTEXT_WINDOW="$DEFAULT_CONTEXT_WINDOW"

# Bug fix 2026-04-11 (updated 2026-04-20): detect extended-context (1M)
# sessions from the model string BEFORE used tokens cross 200k. Previously
# the script only scaled to 1M after used > 200k, which meant a 1M-capable
# session at 185k input tokens (18% actual usage) was reported as "92%"
# (185k/200k) and triggered false pre-compact panic advisories. Pattern
# covers opus/sonnet 4.6+ (all currently 1M) plus explicit "[1m]" tag and
# "-1m" suffixes. Haiku is NOT 1M and must not match. Update the 4-[6-9]
# range whenever a new major opus/sonnet version ships.
case "$MODEL" in
  *opus-4-[6-9]*|*sonnet-4-[6-9]*|*\[1m\]*|*-1m|*-1m-*)
    CONTEXT_WINDOW="$EXTENDED_CONTEXT_WINDOW"
    ;;
esac

# Fallback: if used tokens already exceed default, we're definitely extended.
if [ "$USED_TOKENS" -gt "$CONTEXT_WINDOW" ] && [ "$EXTENDED_CONTEXT_WINDOW" -gt "$CONTEXT_WINDOW" ]; then
  CONTEXT_WINDOW="$EXTENDED_CONTEXT_WINDOW"
fi

[ "$CONTEXT_WINDOW" -gt 0 ] || emit_empty

PERCENT=$((USED_TOKENS * 100 / CONTEXT_WINDOW))

mkdir -p "$SESSION_DIR" 2>/dev/null || emit_empty

# Detect compact/branch: if token count dropped significantly from last reading,
# a context reset happened. Clear all threshold state so we don't fire stale advisories.
LAST_TOKENS_FILE="${SESSION_DIR}/last-used-tokens"
if [ -f "$LAST_TOKENS_FILE" ]; then
  PREV_TOKENS="$(cat "$LAST_TOKENS_FILE" 2>/dev/null)"
  valid_int "$PREV_TOKENS" || PREV_TOKENS=0
  if [ "$PREV_TOKENS" -gt 0 ] && [ "$USED_TOKENS" -lt "$((PREV_TOKENS * 70 / 100))" ]; then
    # Token count dropped >30% — compact or branch happened. Reset thresholds.
    rm -f "${SESSION_DIR}"/crossed-* "${SESSION_DIR}"/.consumed-* 2>/dev/null
  fi
fi
printf '%s' "$USED_TOKENS" > "$LAST_TOKENS_FILE" 2>/dev/null

for threshold in 80 90 95; do
  if [ $((USED_TOKENS * 100)) -ge $((threshold * CONTEXT_WINDOW)) ]; then
    if [ ! -f "${SESSION_DIR}/.consumed-${threshold}" ]; then
      {
        printf 'threshold=%s\n' "$threshold"
        printf 'used_tokens=%s\n' "$USED_TOKENS"
        printf 'context_window=%s\n' "$CONTEXT_WINDOW"
        printf 'percent=%s\n' "$PERCENT"
        printf 'model=%s\n' "$MODEL"
        TZ=America/New_York date '+created_at_et=%Y-%m-%dT%H:%M:%S%z'
      } > "${SESSION_DIR}/crossed-${threshold}" 2>/dev/null || true
    fi
  fi
done

for threshold in 95 90 80; do
  if [ -f "${SESSION_DIR}/crossed-${threshold}" ] && [ ! -f "${SESSION_DIR}/.consumed-${threshold}" ]; then
    for consumed_threshold in 80 90 95; do
      if [ "$consumed_threshold" -le "$threshold" ]; then
        mv -f "${SESSION_DIR}/crossed-${consumed_threshold}" "${SESSION_DIR}/.consumed-${consumed_threshold}" 2>/dev/null || \
          touch "${SESSION_DIR}/.consumed-${consumed_threshold}" 2>/dev/null || true
      fi
    done
    emit_advisory "$threshold"
  fi
done

emit_empty
