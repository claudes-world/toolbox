#!/home/claude/venvs/transcribe/bin/python3
"""Text-to-speech with multiple providers.

Usage:
    speak "Hello, how are you?"
    echo "Hello" | speak
    speak --voice brian "Let me explain..."
    speak --provider openai --voice nova "OpenAI voice."
    speak --out reply.ogg "Saved to file."
    speak --mp3 "Force mp3 output."

Providers:
    openai      OpenAI TTS (default) — cheapest, native opus, simple
    google      Google Cloud TTS — generous free tier, 700+ voices
    elevenlabs  ElevenLabs — premium quality, more voices

OpenAI voices: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer
Google voices: Standard-A through J, Wavenet-A through J, Neural2-A through J
  (use format like en-US-Wavenet-D, en-US-Neural2-C, en-US-Standard-A)
ElevenLabs voices: eric, river, george, daniel, brian, alice, bella

Requires OPENAI_API_KEY (for openai), GCP service account JSON (for google),
or ELEVEN_API_KEY (for elevenlabs).
"""

import argparse
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
try:
    import otel_cli
    otel_cli.setup('speak')
    _tracer = otel_cli.get_tracer(__name__)
except Exception:
    otel_cli = None  # type: ignore[assignment]
    _tracer = None

# --- Provider: OpenAI ---

OPENAI_VOICES = {"alloy", "ash", "ballad", "coral", "echo", "fable", "nova", "onyx", "sage", "shimmer"}
OPENAI_DEFAULT_VOICE = "onyx"

OPENAI_SECRETS = Path.home() / ".secrets" / "openai.env"


def load_openai_key() -> str:
    key = os.environ.get("OPENAI_API_KEY")
    if key:
        return key
    if OPENAI_SECRETS.exists():
        for line in OPENAI_SECRETS.read_text().splitlines():
            line = line.strip()
            if line.startswith("OPENAI_API_KEY="):
                return line.split("=", 1)[1].strip()
    print("error: OPENAI_API_KEY not set. Add it to ~/.secrets/openai.env or export it.", file=sys.stderr)
    sys.exit(1)


def speak_openai(text: str, voice: str, ogg: bool) -> tuple[bytes, str]:
    from openai import OpenAI

    client = OpenAI(api_key=load_openai_key())
    # OpenAI supports opus natively — no ffmpeg needed
    fmt = "opus" if ogg else "mp3"
    response = client.audio.speech.create(
        model="tts-1",
        voice=voice,
        input=text,
        response_format=fmt,
    )
    ext = ".ogg" if ogg else ".mp3"
    return response.content, ext


# --- Provider: Google Cloud TTS ---

GOOGLE_DEFAULT_VOICE = "en-US-Neural2-D"
GOOGLE_SA_PATH = Path.home() / ".secrets" / "gcp-tts-sa.json"


def speak_google(text: str, voice: str, ogg: bool) -> tuple[bytes, str]:
    os.environ.setdefault("GOOGLE_APPLICATION_CREDENTIALS", str(GOOGLE_SA_PATH))

    from google.cloud import texttospeech

    client = texttospeech.TextToSpeechClient()

    # Parse voice name — format: en-US-Neural2-D
    parts = voice.rsplit("-", 1)
    lang_code = "-".join(voice.split("-")[:2]) if "-" in voice else "en-US"

    synthesis_input = texttospeech.SynthesisInput(text=text)
    voice_params = texttospeech.VoiceSelectionParams(
        language_code=lang_code,
        name=voice,
    )

    if ogg:
        audio_config = texttospeech.AudioConfig(
            audio_encoding=texttospeech.AudioEncoding.OGG_OPUS,
        )
        ext = ".ogg"
    else:
        audio_config = texttospeech.AudioConfig(
            audio_encoding=texttospeech.AudioEncoding.MP3,
        )
        ext = ".mp3"

    response = client.synthesize_speech(
        input=synthesis_input,
        voice=voice_params,
        audio_config=audio_config,
    )
    return response.audio_content, ext


# --- Provider: ElevenLabs ---

ELEVENLABS_VOICES = {
    "eric": "cjVigY5qzO86Huf0OWal",
    "river": "SAz9YHcvj6GT2YYXdXww",
    "george": "JBFqnCBsd6RMkjVDRZzb",
    "daniel": "onwK4e9ZLuTAKqWW03F9",
    "brian": "nPczCjzI2devNBz1zQrb",
    "alice": "Xb7hH8MSUJpSbSDYk0k2",
    "bella": "hpp4J3VqNfWAUOO0d1Us",
}
ELEVENLABS_DEFAULT_VOICE = "brian"

ELEVENLABS_MODELS = {
    "flash": "eleven_flash_v2_5",
    "v2": "eleven_multilingual_v2",
    "v3": "eleven_v3",
}

ELEVENLABS_SECRETS = Path.home() / ".secrets" / "elevenlabs.env"


def load_elevenlabs_key() -> str:
    key = os.environ.get("ELEVEN_API_KEY")
    if key:
        return key
    if ELEVENLABS_SECRETS.exists():
        for line in ELEVENLABS_SECRETS.read_text().splitlines():
            line = line.strip()
            if line.startswith("ELEVEN_API_KEY="):
                return line.split("=", 1)[1].strip()
    print("error: ELEVEN_API_KEY not set. Add it to ~/.secrets/elevenlabs.env or export it.", file=sys.stderr)
    sys.exit(1)


def convert_to_ogg(mp3_data: bytes) -> bytes:
    with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as mp3f:
        mp3f.write(mp3_data)
        mp3_path = mp3f.name
    ogg_path = mp3_path + ".ogg"
    try:
        result = subprocess.run(
            ["ffmpeg", "-i", mp3_path, "-c:a", "libopus", "-y", "-loglevel", "error", ogg_path],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            print(f"warning: ogg conversion failed, returning mp3: {result.stderr.strip()}", file=sys.stderr)
            return mp3_data
        return Path(ogg_path).read_bytes()
    finally:
        Path(mp3_path).unlink(missing_ok=True)
        Path(ogg_path).unlink(missing_ok=True)


def speak_elevenlabs(text: str, voice: str, model: str, ogg: bool) -> tuple[bytes, str]:
    from elevenlabs.client import ElevenLabs

    voice_id = ELEVENLABS_VOICES.get(voice)
    if not voice_id:
        print(f"error: unknown elevenlabs voice '{voice}'. Available: {', '.join(ELEVENLABS_VOICES)}", file=sys.stderr)
        sys.exit(1)

    model_id = ELEVENLABS_MODELS.get(model, ELEVENLABS_MODELS["flash"])

    client = ElevenLabs(api_key=load_elevenlabs_key())
    audio = client.text_to_speech.convert(
        text=text,
        voice_id=voice_id,
        model_id=model_id,
        output_format="mp3_44100_128",
    )
    mp3_data = b"".join(audio)
    if ogg:
        return convert_to_ogg(mp3_data), ".ogg"
    return mp3_data, ".mp3"


# --- CLI ---

ALL_VOICES = sorted(OPENAI_VOICES | set(ELEVENLABS_VOICES.keys()))


def main():
    try:
        from opentelemetry import trace as _trace
    except ImportError:
        _trace = None  # type: ignore[assignment]
    _span_ctx = _tracer.start_as_current_span('speak.run') if _tracer else None
    _span = _span_ctx.__enter__() if _span_ctx else None
    try:
        parser = argparse.ArgumentParser(description="Text-to-speech with multiple providers")
        parser.add_argument("text", nargs="?", default=None, help="Text to speak (or pipe via stdin)")
        parser.add_argument("--provider", "-p", default="openai", choices=["openai", "google", "elevenlabs"],
                            help="TTS provider (default: openai)")
        parser.add_argument("--voice", "-v", default=None,
                            help=f"Voice name (default: {OPENAI_DEFAULT_VOICE} for openai, {GOOGLE_DEFAULT_VOICE} for google, {ELEVENLABS_DEFAULT_VOICE} for elevenlabs)")
        parser.add_argument("--model", default="flash", choices=ELEVENLABS_MODELS.keys(),
                            help="ElevenLabs model (default: flash, ignored for openai)")
        parser.add_argument("--out", type=Path, default=None, help="Output file path (default: stdout)")
        parser.add_argument("--mp3", action="store_true", help="Output mp3 instead of ogg opus")
        args = parser.parse_args()

        if args.text:
            text = args.text
        elif not sys.stdin.isatty():
            text = sys.stdin.read().strip()
        else:
            print("error: provide text as an argument or pipe via stdin", file=sys.stderr)
            sys.exit(1)

        if not text:
            print("error: empty text", file=sys.stderr)
            sys.exit(1)

        ogg = not args.mp3

        if args.provider == "openai":
            voice = args.voice or OPENAI_DEFAULT_VOICE
            if voice not in OPENAI_VOICES:
                print(f"error: unknown openai voice '{voice}'. Available: {', '.join(sorted(OPENAI_VOICES))}", file=sys.stderr)
                sys.exit(1)
            audio_data, ext = speak_openai(text, voice, ogg)
        elif args.provider == "google":
            voice = args.voice or GOOGLE_DEFAULT_VOICE
            audio_data, ext = speak_google(text, voice, ogg)
        else:
            voice = args.voice or ELEVENLABS_DEFAULT_VOICE
            audio_data, ext = speak_elevenlabs(text, voice, args.model, ogg)

        if args.out:
            args.out.write_bytes(audio_data)
            print(f"{args.out}", file=sys.stderr)
        else:
            sys.stdout.buffer.write(audio_data)
    except BaseException as e:
        if _span:
            _span.record_exception(e)
            if _trace:
                _span.set_status(_trace.StatusCode.ERROR, str(e))
        raise
    finally:
        if _span_ctx:
            _span_ctx.__exit__(None, None, None)
        if otel_cli:
            otel_cli.shutdown()


if __name__ == "__main__":
    main()
