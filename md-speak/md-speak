#!/home/claude/venvs/transcribe/bin/python3
"""Read markdown documents aloud with multiple voices and smart processing.

Usage:
    md-speak document.md
    md-speak --out output.ogg document.md
    md-speak --no-describe document.md    # skip AI descriptions of code/images

Voice roles (Google Cloud TTS, overridable via env):
    MD_VOICE_HEADING:    Headings (default: en-US-Wavenet-B, deep male)
    MD_VOICE_BODY:       Body text (default: en-US-Wavenet-J, male)
    MD_VOICE_SPECIAL:    Links, figures, code descriptions (default: en-US-Neural2-C, female)
    MD_VOICE_TABLE_KEY:  Table col 0 / headers (default: en-US-Neural2-H, female — row labels)
    MD_VOICE_TABLE_VAL:  Table col 1+ (default: en-US-Neural2-F, female — values)
    MD_VOICE_QUOTE:      Blockquotes (default: en-US-Wavenet-D, male)

Requires:
    - GCP service account at ~/.secrets/gcp-tts-sa.json
    - ANTHROPIC_API_KEY for AI descriptions (or claude CLI on Max plan)
    - ffmpeg for audio stitching
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlparse

import mistune

# --- Voice configuration (env-overridable) ---

VOICES = {
    "heading": os.environ.get("MD_VOICE_HEADING", "en-US-Wavenet-B"),
    "body": os.environ.get("MD_VOICE_BODY", "en-US-Wavenet-J"),
    "special": os.environ.get("MD_VOICE_SPECIAL", "en-US-Neural2-C"),
    "table": os.environ.get("MD_VOICE_TABLE", "en-US-Neural2-F"),
    "table_key": os.environ.get("MD_VOICE_TABLE_KEY", "en-US-Neural2-H"),    # col 0 — row labels
    "table_val": os.environ.get("MD_VOICE_TABLE_VAL", "en-US-Neural2-F"),    # col 1+ — values
    "quote": os.environ.get("MD_VOICE_QUOTE", "en-US-Wavenet-D"),
}

# --- Pauses (seconds) ---

PAUSE = {
    "h1_before": 1.0,
    "h2_before": 0.7,
    "h3_before": 0.35,
    "after_heading": 0.5,
    "between_paragraphs": 0.6,
    "between_list_items": 0.3,
    "between_table_rows": 0.5,
    "between_table_cells": 0.2,
    "after_table": 0.6,
    "hr": 1.5,
    "after_code": 0.5,
    "after_quote": 0.5,
}

# --- Segment types ---

class Segment:
    def __init__(self, text: str, voice: str, pause_before: float = 0, pause_after: float = 0):
        self.text = text.strip()
        self.voice = voice
        self.pause_before = pause_before
        self.pause_after = pause_after


# --- Smart text processing ---

def humanize_url(url: str) -> str:
    """Convert URLs to human-readable descriptions."""
    parsed = urlparse(url)
    host = parsed.hostname or url
    path = parsed.path.strip("/")

    # GitHub repos
    gh_match = re.match(r"github\.com/([^/]+)/([^/]+)(?:/pull/(\d+))?(?:/issues/(\d+))?", f"{host}/{path}")
    if gh_match:
        user, repo = gh_match.group(1), gh_match.group(2)
        pr = gh_match.group(3)
        issue = gh_match.group(4)
        if pr:
            return f"pull request {pr} on {repo}"
        if issue:
            return f"issue {issue} on {repo}"
        return f"{user}'s {repo} repo"

    # npm
    if "npmjs.com" in host:
        pkg = path.split("/")[-1] if path else url
        return f"npm package {pkg}"

    # Localhost
    if host in ("localhost", "127.0.0.1"):
        port = parsed.port or ""
        return f"local service on port {port}" if port else "local service"

    # Generic: just the domain
    return host.replace("www.", "")


def humanize_filepath(filepath: str) -> str:
    """Convert file paths and folder paths to human-readable descriptions."""
    p = Path(filepath)
    name = p.name
    is_dir = filepath.endswith("/") or not p.suffix

    # Check if inside a git repo
    check_dir = str(p) if is_dir else str(p.parent)
    try:
        result = subprocess.run(
            ["git", "-C", check_dir, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=2,
        )
        if result.returncode == 0:
            repo_root = Path(result.stdout.strip())
            repo_name = repo_root.name
            if is_dir:
                return f"{name} folder in {repo_name} project"
            return f"{name} in {repo_name}"
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    # Strip /home/claude/ and convert to spoken form
    s = filepath.replace("/home/claude/", "~/")
    if s.startswith("~/"):
        parts = s.replace("~/", "home/").split("/")
        parts = [p for p in parts if p]
        if len(parts) == 1:
            return parts[0]
        if len(parts) == 2:
            return f"{parts[0]} slash {parts[1]}"
        # For deeper paths, say the last part + context
        if is_dir:
            return f"{parts[-1]} folder in {parts[-2]}"
        return f"{parts[-1]} in {parts[-2]}"

    # Just filename + parent
    if p.parent.name:
        if is_dir:
            return f"{name} folder in {p.parent.name}"
        return f"{name} in {p.parent.name}"
    return name


def humanize_text(text: str) -> str:
    """Process text to humanize URLs, file paths, symbols, and special characters."""
    # Humanize URLs
    text = re.sub(
        r'https?://[^\s,)>]+',
        lambda m: f"link to {humanize_url(m.group())}",
        text,
    )
    # Humanize file paths (absolute paths with 2+ components)
    text = re.sub(
        r'(?:~|/home/claude)?(?:/[\w._-]+){2,}(?:/[\w._-]+)*',
        lambda m: humanize_filepath(m.group()),
        text,
    )
    # Replace arrows with spoken equivalents
    text = text.replace("→", " points to ")
    text = text.replace("←", " pointed to ")
    text = text.replace("->", " points to ")
    text = text.replace("<-", " pointed to ")
    # Replace tilde paths that didn't match the regex above
    text = re.sub(r'~/(\w+)', r'home slash \1', text)
    text = text.replace("~/", "home slash ")
    return text


def describe_with_ai(content: str, prompt: str) -> str:
    """Use Claude to describe code, images, or diagrams."""
    try:
        import anthropic
        client = anthropic.Anthropic()
        response = client.messages.create(
            model="claude-haiku-4-5-20251001",
            max_tokens=150,
            messages=[{"role": "user", "content": f"{prompt}\n\n{content}"}],
        )
        return response.content[0].text.strip()
    except Exception as e:
        print(f"warning: AI description failed: {e}", file=sys.stderr)
        return "content omitted"


# --- Markdown AST walker ---

def extract_text(token) -> str:
    """Recursively extract plain text from a mistune token."""
    if isinstance(token, str):
        return token
    if isinstance(token, dict):
        t = token.get("type", "")
        children = token.get("children")
        raw = token.get("raw", "")

        if t == "text":
            return raw or token.get("text", "")
        if t == "codespan":
            return raw
        if t == "link":
            link_text = ""
            if children:
                link_text = extract_text(children)
            url = token.get("attrs", {}).get("url", "") if isinstance(token.get("attrs"), dict) else token.get("link", "")
            # Try to get URL from attrs
            if not url and "attrs" in token:
                attrs = token["attrs"]
                if isinstance(attrs, dict):
                    url = attrs.get("href", attrs.get("url", ""))
            if url:
                human = humanize_url(url)
                return f"{link_text}, link to {human}" if link_text else f"link to {human}"
            return link_text
        if t == "emphasis":
            return extract_text(children) if children else raw
        if t == "strong":
            return extract_text(children) if children else raw
        if t in ("softbreak", "linebreak"):
            return " "
        if children:
            return extract_text(children)
        return raw
    if isinstance(token, list):
        return " ".join(extract_text(t) for t in token).strip()
    return ""


def process_markdown(md_text: str, use_ai: bool = True) -> list[Segment]:
    """Parse markdown and produce a list of audio segments."""
    md = mistune.create_markdown(renderer=None, plugins=['table'])
    tokens = md(md_text)
    segments: list[Segment] = []

    for token in tokens:
        if not isinstance(token, dict):
            continue

        t = token.get("type", "")
        children = token.get("children")
        raw = token.get("raw", "")

        if t == "heading":
            level = token.get("attrs", {}).get("level", 1) if isinstance(token.get("attrs"), dict) else 1
            text = extract_text(children) if children else raw
            if not text:
                continue
            pause_key = f"h{min(level, 3)}_before"
            segments.append(Segment(
                text=text,
                voice=VOICES["heading"],
                pause_before=PAUSE.get(pause_key, 0.5),
                pause_after=PAUSE["after_heading"],
            ))

        elif t == "paragraph":
            text = extract_text(children) if children else raw
            if not text:
                continue
            # Humanize URLs and file paths
            text = humanize_text(text)
            segments.append(Segment(
                text=text,
                voice=VOICES["body"],
                pause_after=PAUSE["between_paragraphs"],
            ))

        elif t == "block_code":
            code = raw.strip()
            lang = ""
            if isinstance(token.get("attrs"), dict):
                lang = token["attrs"].get("info", "") or ""
            if use_ai and code:
                desc = describe_with_ai(
                    code,
                    f"Describe this {lang or 'code'} in one concise sentence for a listener. Just the description, no preamble.",
                )
                segments.append(Segment(
                    text=f"Code block: {desc}",
                    voice=VOICES["special"],
                    pause_after=PAUSE["after_code"],
                ))
            else:
                lang_label = f"{lang} code" if lang else "code"
                segments.append(Segment(
                    text=f"{lang_label} block omitted",
                    voice=VOICES["special"],
                    pause_after=PAUSE["after_code"],
                ))

        elif t == "list":
            items = children or []
            for item in items:
                if isinstance(item, dict) and item.get("type") == "list_item":
                    item_children = item.get("children", [])
                    text = extract_text(item_children)
                    if text:
                        segments.append(Segment(
                            text=text,
                            voice=VOICES["body"],
                            pause_after=PAUSE["between_list_items"],
                        ))

        elif t == "table":
            children_list = token.get("children", [])
            header_texts = []
            all_rows: list[list[str]] = []

            # First pass: extract headers and all row data
            for child in children_list:
                if not isinstance(child, dict):
                    continue
                ct = child.get("type", "")

                if ct == "table_head":
                    for cell in child.get("children", []):
                        if isinstance(cell, dict) and cell.get("type") == "table_cell":
                            header_texts.append(humanize_text(extract_text(cell.get("children", []))))

                elif ct == "table_body":
                    for table_row in child.get("children", []):
                        if not isinstance(table_row, dict) or table_row.get("type") != "table_row":
                            continue
                        cell_texts = []
                        for cell in table_row.get("children", []):
                            if isinstance(cell, dict) and cell.get("type") == "table_cell":
                                cell_texts.append(humanize_text(extract_text(cell.get("children", []))))
                        if cell_texts:
                            all_rows.append(cell_texts)

            # Ask Haiku which reading mode to use
            num_cols = len(header_texts)
            use_repeat_headers = num_cols >= 4  # default heuristic

            if use_ai and header_texts and all_rows:
                table_preview = " | ".join(header_texts) + "\n"
                for row in all_rows[:3]:
                    table_preview += " | ".join(row) + "\n"
                try:
                    mode = describe_with_ai(
                        table_preview,
                        "You are choosing how to read a table aloud. Reply with ONLY the word 'A' or 'B'.\n"
                        "Mode A: Read column headers once, then each row as 'header1, value1. header2, value2.'\n"
                        "Mode B: For each cell, repeat its column header before the value.\n\n"
                        "Use Mode A for narrow key-value tables (2-3 columns) with obvious structure.\n"
                        "Use Mode B for wide tables (4+ columns), comparison tables, or tables where "
                        "values are ambiguous without their header (numbers, codes, short strings).\n\n"
                        "Which mode for this table?"
                    ).strip().upper()
                    use_repeat_headers = mode.startswith("B")
                except Exception:
                    pass  # fall back to heuristic

            if use_repeat_headers:
                # Mode B: repeat header inline before each value, voiced per column
                for row in all_rows:
                    row_start_len = len(segments)
                    for j, val in enumerate(row):
                        if not val:
                            continue
                        voice = VOICES["table_key"] if j == 0 else VOICES["table_val"]
                        text = f"{header_texts[j]}, {val}" if j < len(header_texts) and header_texts[j] else val
                        segments.append(Segment(
                            text=text,
                            voice=voice,
                            pause_after=PAUSE["between_table_cells"],
                        ))
                    # Upgrade pause after last cell in row (only if any cells were emitted)
                    if len(segments) > row_start_len and segments[-1].pause_after < PAUSE["between_table_rows"]:
                        segments[-1].pause_after = PAUSE["between_table_rows"]
            else:
                # Mode A: headers once (all with table_key voice), then rows cell-by-cell
                header_start_len = len(segments)
                for j, h in enumerate(header_texts):
                    if h:
                        segments.append(Segment(
                            text=h,
                            voice=VOICES["table_key"],
                            pause_after=PAUSE["between_table_cells"],
                        ))
                if len(segments) > header_start_len:
                    # Upgrade pause after last header to row-level
                    if segments[-1].pause_after < PAUSE["between_table_rows"]:
                        segments[-1].pause_after = PAUSE["between_table_rows"]
                for row in all_rows:
                    row_start_len = len(segments)
                    for j, val in enumerate(row):
                        voice = VOICES["table_key"] if j == 0 else VOICES["table_val"]
                        if val:
                            segments.append(Segment(
                                text=val,
                                voice=voice,
                                pause_after=PAUSE["between_table_cells"],
                            ))
                    # Upgrade pause after last cell in row (only if any cells were emitted)
                    if len(segments) > row_start_len and segments[-1].pause_after < PAUSE["between_table_rows"]:
                        segments[-1].pause_after = PAUSE["between_table_rows"]

            segments.append(Segment(text="", voice=VOICES["body"], pause_before=PAUSE["after_table"]))

        elif t == "block_quote":
            text = extract_text(children) if children else raw
            if text:
                segments.append(Segment(
                    text=text,
                    voice=VOICES["quote"],
                    pause_after=PAUSE["after_quote"],
                ))

        elif t == "thematic_break":
            segments.append(Segment(text="", voice=VOICES["body"], pause_before=PAUSE["hr"]))

    # Filter empty segments (pause-only are kept)
    return [s for s in segments if s.text or s.pause_before > 0 or s.pause_after > 0]


# --- SSML helpers ---

def escape_ssml(text: str) -> str:
    """Escape special XML characters for SSML."""
    return (text
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace('"', "&quot;")
            .replace("'", "&apos;"))


def ssml_break(ms: int) -> str:
    """SSML break tag."""
    return f'<break time="{ms}ms"/>'


SSML_BYTE_LIMIT = 4500  # 500-byte safety margin below Google TTS 5000-byte hard limit


def build_ssml(parts: list[str]) -> str:
    """Build a complete SSML string from a list of SSML part strings."""
    ssml_body = "\n".join(parts)
    return f"<speak>\n{ssml_body}\n</speak>"


def split_large_segment(seg: Segment) -> list[Segment]:
    """Split a segment whose text exceeds SSML_BYTE_LIMIT into smaller segments.

    Splitting hierarchy:
    1. Sentence boundaries (. ! ?)
    2. Word boundaries (space)
    3. Grapheme cluster boundaries (UTF-8 codepoints) — for URLs, CJK runs, etc.

    Never truncates. Every byte of original text appears in exactly one output segment.
    First sub-segment inherits pause_before; last inherits pause_after; middle get zero pauses.
    """
    # Leave room for <speak>\n\n</speak> wrapper (17 bytes), <p></p> tags (7 bytes),
    # and up to two <break time="30000ms"/> tags (44 bytes). Total overhead: ~68 bytes.
    max_text_bytes = SSML_BYTE_LIMIT - len("<speak>\n\n</speak>".encode('utf-8')) - 68

    # Fast path: segment fits as-is
    if len(seg.text.encode('utf-8')) <= max_text_bytes:
        return [seg]

    def chunk_texts(texts: list[str], max_bytes: int, join_sep: str = ' ') -> list[str]:
        """Greedily pack texts into byte-limited chunks using join_sep between tokens.

        join_sep=' ' for word/sentence tokens; join_sep='' for grapheme (char) tokens.
        Never truncates — every input character appears in exactly one output chunk.
        """
        chunks: list[str] = []
        current = ''
        for t in texts:
            candidate = (current + join_sep + t) if current else t
            if len(candidate.encode('utf-8')) <= max_bytes:
                current = candidate
            else:
                if current:
                    chunks.append(current)
                # Single item too large — split further
                if len(t.encode('utf-8')) > max_bytes:
                    # Word boundary split
                    words = [w for w in t.split(' ') if w]
                    if len(words) > 1:
                        sub_chunks = chunk_texts(words, max_bytes, join_sep=' ')
                        chunks.extend(sub_chunks[:-1])
                        current = sub_chunks[-1] if sub_chunks else ''
                    else:
                        # Single word too large — grapheme split (Unicode codepoints)
                        # Must use join_sep='' to avoid injecting spaces between chars
                        chars = list(t)
                        sub_chunks = chunk_texts(chars, max_bytes, join_sep='')
                        chunks.extend(sub_chunks[:-1])
                        current = sub_chunks[-1] if sub_chunks else ''
                else:
                    current = t
        if current:
            chunks.append(current)
        return chunks

    # Split on sentence boundaries; keep sentences without trailing space so Segment.strip() is a no-op
    sentences = re.split(r'(?<=[.!?]) ', seg.text)

    text_chunks = chunk_texts(sentences, max_text_bytes)

    # Build sub-segments from chunks
    result: list[Segment] = []
    for i, chunk_text in enumerate(text_chunks):
        pause_before = seg.pause_before if i == 0 else 0.0
        pause_after = seg.pause_after if i == len(text_chunks) - 1 else 0.0
        result.append(Segment(
            text=chunk_text,
            voice=seg.voice,
            pause_before=pause_before,
            pause_after=pause_after,
        ))

    return result if result else [seg]


def segments_to_ssml_batches(segments: list[Segment]) -> list[tuple[str, str]]:
    """Group consecutive same-voice segments into SSML batches.

    Flush triggers:
    1. Voice change (existing behavior)
    2. Next segment would push batch over SSML_BYTE_LIMIT (new)

    Returns list of (ssml_string, voice_name) tuples.
    """
    batches: list[tuple[str, str]] = []
    current_voice: str | None = None
    current_parts: list[str] = []

    def flush():
        nonlocal current_voice, current_parts
        if current_parts and current_voice:
            batches.append((build_ssml(current_parts), current_voice))
        current_parts = []

    for seg in segments:
        # Expand oversized segments before adding to batch
        expanded_segs = split_large_segment(seg)

        for eseg in expanded_segs:
            # Voice change — flush current batch
            if eseg.voice != current_voice:
                flush()
                current_voice = eseg.voice

            # Build candidate SSML parts for this segment
            new_parts: list[str] = []
            if eseg.pause_before > 0:
                new_parts.append(ssml_break(int(eseg.pause_before * 1000)))
            if eseg.text:
                escaped = escape_ssml(eseg.text)
                new_parts.append(f"<p>{escaped}</p>")
            if eseg.pause_after > 0:
                new_parts.append(ssml_break(int(eseg.pause_after * 1000)))

            # Measure byte size via actual serialization
            candidate_parts = current_parts + new_parts
            if len(build_ssml(candidate_parts).encode('utf-8')) > SSML_BYTE_LIMIT:
                # Flush and start new batch with same voice
                flush()
                current_voice = eseg.voice
                current_parts = new_parts
            else:
                current_parts = candidate_parts

    flush()
    return batches


# --- Audio generation ---

def get_tts_client():
    """Get or create a Google Cloud TTS client."""
    os.environ.setdefault(
        "GOOGLE_APPLICATION_CREDENTIALS",
        str(Path.home() / ".secrets" / "gcp-tts-sa.json"),
    )
    from google.cloud import texttospeech
    return texttospeech.TextToSpeechClient(), texttospeech


def generate_ssml_audio(ssml: str, voice: str, output_path: str, rate: float = 0.95):
    """Generate audio from SSML via Google Cloud TTS."""
    client, tts = get_tts_client()
    lang_code = "-".join(voice.split("-")[:2])

    response = client.synthesize_speech(
        input=tts.SynthesisInput(ssml=ssml),
        voice=tts.VoiceSelectionParams(language_code=lang_code, name=voice),
        audio_config=tts.AudioConfig(
            audio_encoding=tts.AudioEncoding.MP3,
            speaking_rate=rate,
        ),
    )
    Path(output_path).write_bytes(response.audio_content)


def add_mp3_metadata(
    file_path: str,
    title: str = "",
    artist: str = "Claude.do",
    album: str = "Claude's World",
    art_path: str = "",
):
    """Add ID3 metadata and album art to an mp3 file using mutagen."""
    from mutagen.mp3 import MP3
    from mutagen.id3 import TIT2, TPE1, TALB, APIC

    # Load or create ID3 tags
    audio = MP3(file_path)
    if audio.tags is None:
        audio.add_tags()
    tags = audio.tags

    if artist:
        tags["TPE1"] = TPE1(encoding=3, text=artist)
    if album:
        tags["TALB"] = TALB(encoding=3, text=album)
    if title:
        tags["TIT2"] = TIT2(encoding=3, text=title)

    # Embed album art
    cover = Path(art_path) if art_path else Path(__file__).resolve().parent.parent / "default-cover.png"
    if cover.exists():
        mime = "image/png" if cover.suffix.lower() == ".png" else "image/jpeg"
        tags["APIC"] = APIC(
            encoding=3,
            mime=mime,
            type=3,  # Cover (front)
            desc="Cover",
            data=cover.read_bytes(),
        )

    tags.save(file_path, v2_version=3)


def stitch_audio(parts: list[str], output_path: str):
    """Concatenate audio files into one mp3 file."""
    if len(parts) == 1:
        # Single part — just copy
        import shutil
        shutil.copy2(parts[0], output_path)
        return

    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
        for part in parts:
            f.write(f"file '{part}'\n")
        concat_file = f.name

    try:
        subprocess.run(
            ["ffmpeg", "-f", "concat", "-safe", "0", "-i", concat_file,
             "-c:a", "libmp3lame", "-b:a", "128k", "-y", "-loglevel", "error", output_path],
            check=True,
        )
    finally:
        Path(concat_file).unlink(missing_ok=True)


# --- Main ---

def main():
    parser = argparse.ArgumentParser(description="Read markdown aloud with multiple voices")
    parser.add_argument("file", help="Markdown file to read")
    parser.add_argument("--out", "-o", type=Path, default=None, help="Output file (default: <input>.mp3)")
    parser.add_argument("--no-describe", action="store_true", help="Skip AI descriptions of code/images")
    args = parser.parse_args()

    md_path = Path(args.file)
    if not md_path.exists():
        print(f"error: file not found: {md_path}", file=sys.stderr)
        sys.exit(1)

    output = args.out or md_path.with_suffix(".mp3")
    md_text = md_path.read_text()

    print(f"Parsing {md_path.name}...", file=sys.stderr)
    segments = process_markdown(md_text, use_ai=not args.no_describe)
    print(f"Generated {len(segments)} segments", file=sys.stderr)

    # Batch into SSML by voice
    batches = segments_to_ssml_batches(segments)
    chunk_count = len(batches)
    print(f"Batched into {chunk_count} SSML calls (was {len(segments)} segments)", file=sys.stderr)
    if chunk_count > 20:
        print(f"warning: high chunk count ({chunk_count}) — document may be very long or segmentation is fragmented", file=sys.stderr)

    # Generate audio for each batch
    tmpdir = tempfile.mkdtemp(prefix="md-speak-")
    parts: list[str] = []
    char_count = 0

    for i, (ssml, voice) in enumerate(batches):
        audio_path = f"{tmpdir}/batch-{i}.mp3"
        # Count chars (rough — includes SSML tags but close enough)
        text_chars = len(re.sub(r'<[^>]+>', '', ssml))
        char_count += text_chars
        preview = re.sub(r'<[^>]+>', '', ssml).strip()[:60]
        print(f"  [{i+1}/{len(batches)}] {voice}: {preview}{'...' if len(preview) >= 60 else ''}", file=sys.stderr)
        rate = 1.05 if voice == VOICES["body"] else 0.95
        generate_ssml_audio(ssml, voice, audio_path, rate=rate)
        parts.append(audio_path)

    if not parts:
        print("error: no audio segments generated", file=sys.stderr)
        sys.exit(1)

    # Generate "end of document" closing line in the female voice
    doc_name = md_path.stem.replace("-", " ").replace("_", " ").title()
    end_ssml = f'<speak><break time="800ms"/><p>{escape_ssml("This is the end of: " + doc_name)}</p></speak>'
    end_audio_path = f"{tmpdir}/end-segment.mp3"
    print(f"  [END] {VOICES['special']}: This is the end of: {doc_name}", file=sys.stderr)
    generate_ssml_audio(end_ssml, VOICES["special"], end_audio_path)
    parts.append(end_audio_path)

    print(f"Stitching {len(parts)} audio parts...", file=sys.stderr)
    stitch_audio(parts, str(output))

    # Add metadata (artist, title, album art)
    doc_title = md_path.stem.replace("-", " ").replace("_", " ").title()
    add_mp3_metadata(str(output), title=doc_title)

    # Cleanup
    for p in parts:
        Path(p).unlink(missing_ok=True)
    Path(tmpdir).rmdir()

    print(f"{output} ({char_count} chars)", file=sys.stderr)
    print(str(output))


if __name__ == "__main__":
    main()
